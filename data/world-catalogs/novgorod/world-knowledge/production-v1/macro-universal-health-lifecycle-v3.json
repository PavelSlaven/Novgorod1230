  "evidence": [
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:candidate-v3-child-development-periods","source_ref":"source:candidate-v3-medlineplus-child-development","anchor":{"section":"Normal growth and development"},"note":"The entry divides child growth and development into infancy, preschool years, middle childhood and adolescence. It establishes no age, development, capacity or state of a particular child.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:candidate-v3-puberty-growth-spurt","source_ref":"source:candidate-v3-medlineplus-child-development","anchor":{"section":"Normal growth and development"},"note":"The entry states that a final growth spurt begins at the start of puberty. It establishes no age, timing, growth rate or individual development.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:candidate-v3-aging-cell-function","source_ref":"source:candidate-v3-medlineplus-aging","anchor":{"section":"Aging changes"},"note":"The entry states that cells change with aging and many lose functional capacity or function abnormally. It establishes no age, impairment, prognosis or individual state.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:candidate-v3-aging-organ-function","source_ref":"source:candidate-v3-medlineplus-aging","anchor":{"section":"Aging changes"},"note":"The entry states that organs slowly lose function with aging and that change varies between people and organs. It establishes no individual capacity, diagnosis or outcome.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:candidate-v3-fracture-force","source_ref":"source:candidate-v3-medlineplus-fracture","anchor":{"section":"Definition"},"note":"The entry states that a bone can split or break when more pressure is put on it than it can stand. It establishes no force, bone condition, injury or outcome.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:candidate-v3-dislocation-position","source_ref":"source:candidate-v3-medlineplus-dislocation","anchor":{"section":"Definition"},"note":"The entry defines a dislocation as disruption of the normal position of bones meeting at a joint. It establishes no injury, body part, severity or treatment.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:candidate-v3-poison-exposure-routes","source_ref":"source:candidate-v3-medlineplus-poisoning","anchor":{"section":"Summary"},"note":"The entry identifies swallowing, inhalation, injection and skin absorption as possible poison exposure routes. It establishes no substance, dose, exposure, symptom, diagnosis or outcome.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:candidate-v3-tooth-decay-acid","source_ref":"source:candidate-v3-nidcr-tooth-decay","anchor":{"section":"Overview"},"note":"NIDCR states that oral bacteria make acids which attack tooth enamel. It establishes no person, food, oral condition, symptom, diagnosis or treatment.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:candidate-v3-disability-interaction","source_ref":"source:candidate-v3-who-disability","anchor":{"section":"Overview"},"note":"WHO describes disability as arising from interaction between health conditions and environmental and personal factors. It establishes no person, condition, ability, access or social outcome.","review_status":"approved"}
