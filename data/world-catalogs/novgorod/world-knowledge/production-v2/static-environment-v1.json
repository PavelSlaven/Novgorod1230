  "evidence": [
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:research-environment-freeze-thaw-sediment",
      "source_ref": "source:research-usgs-freeze-thaw-bank-erosion",
      "anchor": {
        "section": "Detailed Description"
      },
      "note": "USGS describes freeze–thaw as ice expansion that can break up previously consolidated soil/sediment, after which loosened material can be more erosion-vulnerable. Distinct from rock-fracture only. No actual bank, collapse, rate, season, sediment type, water level, access or outcome.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:research-environment-flood-high-water-mark-types",
      "source_ref": "source:research-usgs-high-water-marks",
      "anchor": {
        "section": "A Look at the Evidence; Rapid-High-Water Marks"
      },
      "note": "USGS identifies deposited mud, snagged debris, and erosion scars among high-water-mark types. No local flood, event date, peak, cause, magnitude, water level, route decision or future risk.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:research-environment-porous-mark-wicking-corroboration",
      "source_ref": "source:research-usgs-high-water-marks",
      "anchor": {
        "section": "Tranquil High-Water Marks — Mud Lines, paragraphs beginning ‘Porous materials such as wood and concrete…’ and ‘To ensure accuracy…’"
      },
      "note": "USGS explains that capillary wicking can place a porous-surface stain above a water peak and that nearby nonporous corroborating marks improve assessment. No actual mark, material, elevation, confidence value, survey, flood or conclusion.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:research-environment-smoke-transport-dispersion",
      "source_ref": "source:research-nws-fire-weather-glossary",
      "anchor": {
        "section": "Fire Weather Glossary — Smoke Transport"
      },
      "note": "NWS defines smoke transport through atmospheric conditions including wind and atmospheric stability/instability. No fire, smoke, weather state, plume direction, distance, concentration, exposure, visibility or outcome.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:research-environment-inversion-smoke-trapping",
      "source_ref": "source:research-nws-wisconsin-aop-2019",
      "anchor": {
        "section": "Appendix B — Smoke Management/HYSPLIT Requests, paragraph beginning ‘A temperature inversion would serve to trap smoke…’"
      },
      "note": "NWS states that a temperature inversion can trap smoke and prevent sufficient lofting for dilution or wind transport. No actual inversion, time, terrain, wind, smoke source, concentration, effect, direction or safe place.",
