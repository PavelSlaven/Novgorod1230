{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rus.perception.npc_reaction_routing_v1",
  "type": "object",
  "required": ["version","schema","routing_id","party_id","event_id","observer_id","reaction_policy_id","state_version","status","options","trace_digest"],
