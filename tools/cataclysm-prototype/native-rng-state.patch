+void rng_serialize_engine( std::ostream &out )
+{
+    out << rng_get_engine() << '\n';
+}
+
+bool rng_unserialize_engine( std::istream &in )
+{
+    cata_default_random_engine restored;
+    if( !( in >> restored ) ) {
+        return false;
+    }
+    in >> std::ws;
+    if( !in.eof() || in.bad() ) {
+        return false;
+    }
+    rng_get_engine() = restored;
+    return true;
+}
