  "evidence": [
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:static-fat-storm-b10-gentle-rendering-avoids-burning","source_ref":"source:static-fat-storm-b10-umn-rendering","anchor":{"section":"Render Dry—Avoid Burning"},"note":"UMN Extension directs beginning dry rendering at low heat as fat breaks down, stirring to prevent sticking and burning, and explicitly warns not to overheat or burn the fat. This is pork-lard handling guidance; it supplies no universal temperature, yield, time, purity, safety, or concrete-scene result.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:static-fat-storm-b10-animal-fat-wick-fuel","source_ref":"source:static-fat-storm-b10-museum-wales-lamp","anchor":{"section":"Roman lead lamp holder, description"},"note":"Museum Wales describes oil lamps filled with vegetable or olive oil, or sometimes animal fat as fuel, with a wick for lighting. It documents a Roman lamp context, not a Novgorod lamp type, local availability, lamp construction, brightness, duration, or safety.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:static-fat-storm-b10-lightning-outdoor-exposure","source_ref":"source:static-fat-storm-b10-nws-outdoors","anchor":{"section":"When a Safe Location is not Nearby"},"note":"NWS states that an outdoor person is not safe in a thunderstorm and advises staying away from tall isolated trees and water. This is modern lightning-risk guidance, not a local forecast, a procedure, an outcome, or a guarantee that another outdoor position is safe.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:static-fat-storm-b10-substantial-building-option","source_ref":"source:static-fat-storm-b10-nws-overview","anchor":{"section":"Overview: Lightning Safety"},"note":"NWS names substantial buildings and hard-topped vehicles as safe options, while rain shelters, small sheds, and open vehicles are not safe. This establishes a qualitative destination if one is reachable, not a building's presence, construction, access, complete safety, or scene outcome.","review_status":"approved"}
