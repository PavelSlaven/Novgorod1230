{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rus.world_base_source_bundle.v1",
  "title": "Tracked world_base source bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "archive", "importer_manifest", "files"],
  "properties": {
    "schema_version": { "const": "rus.world_base_source_bundle.v1" },
    "bundle_id": { "type": "string", "minLength": 1 },
    "archive": { "$ref": "#/$defs/contentAddressedPath" },
    "importer_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/contentAddressedPath" }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "contentAddressedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
