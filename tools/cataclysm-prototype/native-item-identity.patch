+ret_val<item *> item_contents::insert_item_preserving_identity( item &&it,
+        pocket_type pk_type, bool ignore_contents )
+{
+    if( pk_type == pocket_type::LAST ) {
+        pk_type = pocket_type::CONTAINER;
+    }
+    ret_val<item_pocket *> pocket = find_pocket_for( it, pk_type );
+    if( !pocket.success() ) {
+        return ret_val<item *>::make_failure( nullptr, pocket.str() );
+    }
+    return pocket.value()->insert_item_preserving_identity( std::move( it ), false, ignore_contents );
+}
