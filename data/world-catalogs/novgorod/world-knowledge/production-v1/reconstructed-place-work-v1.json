  "claim_localizations": [
    {
      "schema": "world_knowledge_claim_localization_v1",
      "claim_ref": "claim:reconstructed-place-work-wet-hot-dry-tasks-can-require-sequencing",
      "locale": "ru",
      "runtime_text": "Мокрая работа может увлажнить оставленные рядом сухие ткань или зерно, а горячая обработка требует убрать от жара легко воспламеняющийся мусор. Поэтому на общей поверхности такие дела разумно разводить по очереди; это не задаёт процедуру или состояние места.",
      "search_aliases": [
        "мокрая работа",
        "горячая работа"
      ]
    },
    {
      "schema": "world_knowledge_claim_localization_v1",
      "claim_ref": "claim:reconstructed-place-work-wet-hot-dry-tasks-can-require-sequencing",
      "locale": "en",
      "runtime_text": "Wet work can dampen nearby dry cloth or grain, while hot work needs easy fuel moved away from heat. Those tasks can therefore need sequencing on a shared surface; this establishes no procedure or place state.",
