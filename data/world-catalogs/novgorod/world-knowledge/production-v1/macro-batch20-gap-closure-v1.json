  "evidence": [
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:macro-b20-apiary-weather","source_ref":"source:research-osu-honeybee-colony-pollination","anchor":{"section":"Honey bee flight"},"note":"OSU states that honey-bee foraging needs suitable light and temperature and that poor weather can interrupt collection. It supports weather-conditioned colony activity, not a procedure, local colony, inspection, or outcome.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:macro-b20-horse-cooldown","source_ref":"source:macro-b20-horse-cooldown","anchor":{"section":"Cooling down"},"note":"Equine guidance describes a gradual cool-down after work and attention to recovery signs. It sets no animal, work, duration, treatment, diagnosis, or outcome.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:macro-b20-dog-weather-scent","source_ref":"source:macro-b20-dog-weather-scent","anchor":{"section":"Abstract"},"note":"The study addresses weather effects on search-dog performance. It supports weather as a condition on scent work, not identification, a trail, a dog, or success/failure.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:macro-b20-resin-handling","source_ref":"source:macro-b20-editorial-resin-tool-handling","anchor":{"section":"Resin on hand tools"},"note":"This is an explicitly bounded ordinary physical reconstruction: sticky residue on an already present tool is a handling condition, so it can be kept away from precise work or removed by a compatible available means. It gives no solvent, recipe, tool, timber, state, or successful cleaning.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:macro-b20-wool-insects","source_ref":"source:macro-b20-cci-insects","anchor":{"section":"Damage from insects"},"note":"CCI describes insects as agents of deterioration for organic collection materials. It supports inspection and dry, clean isolation as qualitative preservation logic, not a particular insect, infestation, textile, poison, or cure.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:macro-b20-embers-ash","source_ref":"source:macro-b20-usfs-campfire","anchor":{"section":"Extinguish your campfire"},"note":"USFS instructs that embers must be cooled and checked before a fire is left. It supports retained heat as a hazard under ash, not a present fire, fuel, time, or ignition outcome.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:macro-b20-snow-glare","source_ref":"source:macro-b20-nei-photokeratitis","anchor":{"section":"Causes"},"note":"NEI identifies sunlight reflected from snow as a source of ultraviolet exposure that can hurt eyes. It supports glare as an exposure condition, not weather, diagnosis, vision value, or recovery.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:macro-b20-steam-bending","source_ref":"source:macro-b20-fpl-bending","anchor":{"section":"Bending and forming"},"note":"FPL discusses conditioning wood for bending and holding the form while it sets. It supports controlled restraint and drying as qualitative process requirements, not a wood species, temperature, time, form, or finished object.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:macro-b20-hot-pitch","source_ref":"source:macro-b20-osha-asphalt","anchor":{"section":"Hazards"},"note":"OSHA treats hot bitumen/asphalt work as a burn and fume-exposure hazard. It supports avoiding direct skin contact and limiting fume exposure for already heated pitch, not a historical recipe, temperature, quantity, injury, combustibility, or fire outcome.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:macro-b20-ankle-observation","source_ref":"source:macro-b20-nhs-sprains","anchor":{"section":"Urgent advice"},"note":"NHS distinguishes simple self-care from warning signs needing urgent assessment. It supports temporary protection and observation without identifying an injury or prescribing treatment.","review_status":"approved"}
