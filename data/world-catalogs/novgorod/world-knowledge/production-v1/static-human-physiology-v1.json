  "claim_localizations":[
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:research-global-cerebral-hypoperfusion-can-cause-syncope","locale":"ru","runtime_text":"Кратковременное глобальное снижение перфузии мозга может вызвать обморок — преходящую потерю сознания. Это не устанавливает причину, диагноз, длительность, падение, восстановление, повторение или состояние конкретного персонажа.","search_aliases":[]},{"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:research-global-cerebral-hypoperfusion-can-cause-syncope","locale":"en","runtime_text":"Transient global cerebral hypoperfusion can cause syncope, a transient loss of consciousness. This establishes no cause, diagnosis, duration, fall, recovery, recurrence, or concrete actor state.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:research-acute-circulatory-failure-can-reduce-tissue-perfusion","locale":"ru","runtime_text":"Острая недостаточность кровообращения может приводить к недостаточной перфузии тканей и клеточной дисфункции. Это не устанавливает диагноз, тип или причину, давление, симптом, органный исход, тяжесть или лечение.","search_aliases":[]},{"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:research-acute-circulatory-failure-can-reduce-tissue-perfusion","locale":"en","runtime_text":"Acute circulatory failure can cause inadequate tissue perfusion and cellular dysfunction. This establishes no diagnosis, type or cause, blood pressure, symptom, organ outcome, severity, or treatment.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:research-bright-retinal-light-can-constrict-pupils","locale":"ru","runtime_text":"Яркий свет, попадающий на сетчатку, может вызывать парасимпатическое сужение зрачков. Это не устанавливает свет, зрение, состояние глаза, размер зрачка, восприятие или состояние конкретного персонажа.","search_aliases":[]},{"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:research-bright-retinal-light-can-constrict-pupils","locale":"en","runtime_text":"Bright light reaching the retina can elicit parasympathetic pupil constriction. This establishes no light, visual function, eye condition, pupil measurement, perception, or concrete actor state.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:research-extreme-heat-can-increase-body-heat-storage","locale":"ru","runtime_text":"Сильная жара или работа в горячей среде могут увеличивать накопление тепла в теле. Это не устанавливает температуру, работу, одежду, гидратацию, болезнь, травму, диагноз, нарушение функций или исход.","search_aliases":[]},{"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:research-extreme-heat-can-increase-body-heat-storage","locale":"en","runtime_text":"Extreme heat or work in a hot environment can increase body heat storage. This establishes no temperature, work, clothing, hydration, illness, injury, diagnosis, impairment, or outcome.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:research-extreme-cold-can-cause-cold-stress","locale":"ru","runtime_text":"Сильный холод или воздействие холодной среды могут вызывать холодовой стресс и быструю потерю тепла телом. Это не устанавливает температуру, длительность, одежду, температуру тела, диагноз, нарушение функций, выживание или лечение.","search_aliases":[]},{"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:research-extreme-cold-can-cause-cold-stress","locale":"en","runtime_text":"Extreme cold or cold-environment exposure can cause cold stress and rapid body heat loss. This establishes no temperature, duration, clothing, body temperature, diagnosis, impairment, survival, or treatment.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:research-novel-stimulus-can-elicit-orienting-response","locale":"ru","runtime_text":"Новый или неожиданный стимул может вызывать ориентировочную реакцию, направляющую сенсорное внимание, и она может ослабевать при повторении. Это не устанавливает замечание, направление взгляда или тела, узнавание, эмоцию, угрозу, решение, действие или восприятие конкретного персонажа.","search_aliases":[]},{"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:research-novel-stimulus-can-elicit-orienting-response","locale":"en","runtime_text":"A novel or unexpected stimulus can elicit an orienting response that directs sensory attention and can habituate with repetition. This establishes no notice, gaze or body direction, recognition, emotion, threat, decision, action, or perception of a concrete actor.","search_aliases":[]}
