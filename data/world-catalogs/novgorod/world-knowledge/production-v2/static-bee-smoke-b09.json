  "evidence": [
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:static-bee-smoke-b09-smoke-reduces-alarm-perception","source_ref":"source:static-bee-smoke-b09-uiuc-alarm-perception","anchor":{"section":"Abstract"},"note":"Visscher, Vetter and Robinson report that smoke reduced antennal electroantennograph response to alarm pheromones; the response gradually returned to control levels within 10–20 minutes. The authors identify reduced peripheral sensitivity as one component of reduced nest defense, not a guarantee that a colony becomes calm.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:static-bee-smoke-b09-smoke-can-prompt-honey-engorgement","source_ref":"source:static-bee-smoke-b09-usu-beekeeping","anchor":{"section":"Smoking the Hive"},"note":"USU Extension states that smoke can prompt bees to gorge on honey and makes them less likely to sting, while a few may remain active. It establishes neither a particular colony response nor safe access to a concrete hive.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:static-bee-smoke-b09-excess-smoke-irritation","source_ref":"source:static-bee-smoke-b09-arizona-working-hive","anchor":{"section":"Smoking"},"note":"University of Arizona Cooperative Extension warns that over-smoking can irritate bees. This is a qualitative handling limit, not a dose, injury diagnosis, or guaranteed outcome.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:static-bee-smoke-b09-hot-smoke-limit","source_ref":"source:static-bee-smoke-b09-tufts-hand-temperature","anchor":{"section":"paragraph beginning ‘The smoke’s temperature is tested with a bare hand’"},"note":"Tufts University advises that smoke too hot for a bare hand is too hot for bees. This is a qualitative heat limit, not a temperature threshold, burn diagnosis, or guaranteed outcome.","review_status":"approved"}
  ],
