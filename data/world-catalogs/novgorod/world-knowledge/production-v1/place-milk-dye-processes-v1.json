  "evidence": [
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:place-milk-curd-formation",
      "source_ref": "source:place-milk-dye-fao-cheese-process",
      "anchor": {"section": "Processing stages: Coagulation"},
      "note": "FAO describes enzymic and lactic-acid clotting as distinct mechanisms that both form a curd or clot. Universal process relation only; no ingredient, recipe, duration, milk state, or product follows.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:place-milk-curd-whey-separation",
      "source_ref": "source:place-milk-dye-fao-cheese-process",
      "anchor": {"section": "Processing stages: Draining"},
      "note": "FAO describes progressive curd-whey separation after fresh coagulation, with most water and lactose in whey and protein/fat increasingly concentrated in curd according to draining method. No quantity, rate, yield, texture, safety, or particular batch follows.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:place-milk-straining-support",
      "source_ref": "source:place-milk-dye-fao-cheese-process",
      "anchor": {"section": "Fresh cheese: Draining"},
      "note": "FAO describes traditional moulding in draining bags or hoops while handling a fragile curd. This supports only an editorial relation between an already established curd, permeable support, and liquid drainage; it supplies no medieval implement, required technique, or result.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:place-dye-preparation-and-evenness",
      "source_ref": "source:place-milk-dye-usu-indigo",
      "anchor": {"section": "Preparing the Fabric; Method 2, dye-vat movement"},
      "note": "USU Extension says inadequate scouring can result in blotchy uptake and, for its indigo method, periodic gentle movement aims to ensure even dyeing. This is a modern process observation, not a medieval recipe, universal guarantee, dye identity, or present textile state.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:place-dye-dye-fibre-process-conditions",
      "source_ref": "source:place-milk-dye-hossain-process-variables",
      "anchor": {"section": "§3.1.2–3.1.3, Effects of dyeing time and temperature"},
      "note": "For its reactive dyes on cotton and viscose, Hossain et al. describe dye transfer from bath to fibre and diffusion inside the textile, with time and temperature changing uptake around an equilibrium. This supports a qualitative conditional transfer relation, not a universal monotonic temperature rule, natural-dye practice, or outcome for a particular bath.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:place-dye-stirring-evenness",
      "source_ref": "source:place-milk-dye-uvm-garden-dyes",
      "anchor": {"section": "Making dyes from your garden, dye-bath step"},
      "note": "UVM Extension presents stirring a dye pot to seek even colour. It supports a narrow editorial work relation only; stirring supplies neither a guaranteed even result nor a fixed dye, fibre, bath, temperature, or historical practice.",
      "review_status": "approved"
    }
  ],
