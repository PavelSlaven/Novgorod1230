        "archaeological_settlement": "peasant_homestead",
        "burial_area": "gap: no place-first family for a burial ground / cemetery outside a churchyard (lifecycle rites and burial domain missing)"
      }
    },
    "g5_suffix_rules": {
      "rule": "G5 pf: (1) first keyword rule whose token occurs in the G5 id suffix (after the parent G4 id) gives the pf; @parent means the parent G4 pf; (2) else the parent pf if it is in the scene-template crosswalk of the G5; (3) else the first scene-template pf that is in the parent family composes_with (WK); (4) else inherit the parent pf. Parent gap -> G5 gap.",
      "keywords": [
        {
          "tokens": [
            "open_pool",
            "deep_pool",
            "still_water",
            "shallow_pool",
            "resource_patch",
            "_pool",
            "dry_cap"
          ],
          "pf": "@parent"
        },
        {
          "tokens": [
            "water_approach",
            "river_approach",
            "river_side",
            "water_source",
            "water_access"
          ],
          "pf": "riverbank"
        },
        {
          "tokens": [
            "ice_edge",
            "winter_thin_ice",
            "winter_crack",
            "ice_break_zone"
          ],
          "pf": "winter_ice_crossing"
        },
        {
          "tokens": [
            "household_cluster",
            "household_zone",
            "habitation_terrace",
            "occupation_terrace"
          ],
          "pf": "peasant_homestead"
        },
        {
          "tokens": [
            "work_storage",
            "storage_zone",
