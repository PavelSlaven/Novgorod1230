  "claim_localizations": [
    {
      "schema": "world_knowledge_claim_localization_v1",
      "claim_ref": "claim:water-wetting-forces",
      "locale": "ru",
      "runtime_text": "Растекание жидкости или образование капель на поверхности зависит от соотношения сил сцепления внутри жидкости и её сцепления с поверхностью; это соотношение выражается краевым углом. Смачиваемость не устанавливает пористость, проницаемость или результат трения.",
      "search_aliases": [
        "Смачивание",
        "Капли на поверхности"
      ]
    },
    {
      "schema": "world_knowledge_claim_localization_v1",
      "claim_ref": "claim:water-wetting-forces",
      "locale": "en",
      "runtime_text": "Liquid spreading or beading depends on relative liquid cohesion and liquid-surface adhesion, expressed by contact angle. Wettability establishes neither porosity, permeability nor a friction result.",
      "search_aliases": [
        "Wetting",
        "Beading on a surface"
      ]
    },
    {
      "schema": "world_knowledge_claim_localization_v1",
      "claim_ref": "claim:water-capillary-rise-depression",
      "locale": "ru",
      "runtime_text": "В узкой трубке капиллярное действие может поднимать или понижать уровень жидкости в зависимости от сочетания жидкости и твёрдой поверхности и краевого угла. Это не доказывает наличие капиллярного пути, воды или её поступления в конкретный предмет.",
      "search_aliases": [
        "Капиллярное поднятие",
        "Капиллярное понижение"
      ]
    },
    {
      "schema": "world_knowledge_claim_localization_v1",
      "claim_ref": "claim:water-capillary-rise-depression",
      "locale": "en",
      "runtime_text": "In a narrow tube, capillary action can raise or depress a liquid level depending on the liquid-solid combination and contact angle. This does not prove a capillary path, water presence or uptake in a particular object.",
      "search_aliases": [
        "Capillary rise",
        "Capillary depression"
      ]
    },
    {
      "schema": "world_knowledge_claim_localization_v1",
      "claim_ref": "claim:water-capillary-height",
      "locale": "ru",
      "runtime_text": "В модели вертикального капилляра равновесная высота зависит от поверхностного натяжения, краевого угла, радиуса трубки, плотности жидкости и тяжести. При прочих равных там, где возникает поднятие, меньший радиус даёт большую высоту. Это не задаёт высоту, направление или расход в неизвестной сети пор.",
      "search_aliases": [
        "Высота капиллярного поднятия",
        "Радиус капилляра"
      ]
    },
    {
      "schema": "world_knowledge_claim_localization_v1",
      "claim_ref": "claim:water-capillary-height",
      "locale": "en",
      "runtime_text": "In the vertical-capillary model, equilibrium height depends on surface tension, contact angle, tube radius, liquid density and gravity. Other factors equal, a smaller radius gives greater height where rise occurs. This supplies no height, direction or flow rate for an unspecified pore network.",
      "search_aliases": [
        "Capillary rise height",
        "Capillary radius"
      ]
    },
    {
      "schema": "world_knowledge_claim_localization_v1",
      "claim_ref": "claim:water-percolation-openings",
      "locale": "ru",
      "runtime_text": "Перколяция — движение воды через отверстия в горной породе или почве. Нужны вода и реальные отверстия; определение не доказывает связный путь, скорость, доступный подземный источник или количество воды в сцене.",
      "search_aliases": [
        "Перколяция",
        "Вода через почву"
      ]
    },
    {
      "schema": "world_knowledge_claim_localization_v1",
      "claim_ref": "claim:water-percolation-openings",
      "locale": "en",
      "runtime_text": "Percolation is movement of water through openings in rock or soil. Water and actual openings are needed; the definition proves no connected path, rate, accessible underground source or scene water quantity.",
      "search_aliases": [
        "Percolation",
        "Water through soil"
      ]
    },
    {
      "schema": "world_knowledge_claim_localization_v1",
      "claim_ref": "claim:water-permeability-connected-pores",
      "locale": "ru",
      "runtime_text": "Проницаемость — способность пропускать жидкость; пористость описывает долю пустот. Движение воды зависит не только от этой доли, но и от размера пустот и того, сообщаются ли они. Изолированные поры не доказывают сквозной путь; большая пористость сама по себе не означает хорошее прохождение воды.",
      "search_aliases": [
        "Пористость и проницаемость",
        "Сообщающиеся поры"
      ]
    },
    {
      "schema": "world_knowledge_claim_localization_v1",
      "claim_ref": "claim:water-permeability-connected-pores",
      "locale": "en",
      "runtime_text": "Permeability is capacity to transmit liquid; porosity describes the proportion of void space. Water movement depends not only on that proportion but on void size and interconnection. Isolated pores establish no through-path; high porosity alone does not mean ready water passage.",
      "search_aliases": [
        "Porosity and permeability",
        "Interconnected pores"
      ]
    }
