  "evidence": [
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:residual-postpartum-who-postbirth-bleeding-infection","source_ref":"source:residual-postpartum-who-maternal-mortality","anchor":{"section":"Why do women die?"},"note":"WHO lists severe bleeding, mostly after childbirth, and infections, usually after childbirth, among major maternal complications. It establishes no bleeding, infection, severity or outcome for an actor.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:residual-postpartum-who-maternal-newborn-link","source_ref":"source:residual-postpartum-who-maternal-mortality","anchor":{"section":"How can women's lives be saved?"},"note":"WHO states that maternal and newborn health are closely linked and that care before, during and after childbirth can save lives. It establishes no available care, actor state or outcome.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:residual-postpartum-ncbi-uterine-contraction","source_ref":"source:residual-postpartum-ncbi-breastfeeding-physiology","anchor":{"section":"2.5. Hormonal control of milk production; Oxytocin"},"note":"The chapter states that oxytocin makes the uterus contract after delivery and helps reduce bleeding. It establishes no individual recovery, bleeding amount or outcome.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:residual-postpartum-ncbi-lactation-feedback","source_ref":"source:residual-postpartum-ncbi-breastfeeding-physiology","anchor":{"section":"2.5. Hormonal control of milk production; Prolactin"},"note":"The chapter states that suckling raises prolactin and, especially in the first weeks, more stimulation is associated with more milk production. It establishes no individual supply, feeding success or instruction.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:residual-postpartum-ncbi-milk-ejection","source_ref":"source:residual-postpartum-ncbi-breastfeeding-physiology","anchor":{"section":"2.5. Hormonal control of milk production; Oxytocin"},"note":"The chapter states that oxytocin contracts myoepithelial cells around alveoli, moving already collected milk into ducts. It establishes no individual feeding state or outcome.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:residual-postpartum-ncbi-colostrum","source_ref":"source:residual-postpartum-ncbi-breastfeeding-physiology","anchor":{"section":"2.2. Colostrum and mature milk"},"note":"The chapter describes colostrum as milk secreted in the first 2–3 days after delivery, produced in small amounts and rich in immune factors. It establishes no individual milk, timing or infant state.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:residual-postpartum-ncbi-breastmilk-immune-factors","source_ref":"source:residual-postpartum-ncbi-breastfeeding-physiology","anchor":{"section":"2.1. Breast-milk composition; Anti-infective factors"},"note":"The chapter describes breast-milk bioactive and anti-infective factors that augment an infant's immature immune system. It establishes no exposure, infection, immunity or outcome for an infant.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:residual-postpartum-who-first-week","source_ref":"source:residual-postpartum-who-newborn-health","anchor":{"section":"Overview"},"note":"WHO identifies care around birth and during the first week of life as a focus for newborn survival and thriving. It establishes no age, health state, care availability or outcome for an infant.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:residual-postpartum-who-feeding-infection-protection","source_ref":"source:residual-postpartum-who-infant-feeding","anchor":{"section":"Breastfeeding"},"note":"WHO states that early, exclusive and continued breastfeeding protects infants and children from infectious diseases. It establishes no feeding history, illness, protection level or outcome for an infant.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:residual-postpartum-who-nutrition-early-life","source_ref":"source:residual-postpartum-who-infant-feeding","anchor":{"section":"Overview"},"note":"WHO states that the first two years are important for nutrition and that optimal nutrition lowers morbidity and mortality while supporting growth and development. It establishes no diet, growth, disease or outcome for an individual child.","review_status":"approved"}
  ],
