  "claim_localizations": [
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:static-bee-smoke-b09-smoke-can-temporarily-reduce-alarm-pheromone-perception-and-defense","locale":"ru","runtime_text":"Дым может временно ослабить восприятие медоносными пчёлами тревожного феромона и уменьшить защитную реакцию семьи. Это не гарантирует спокойствие, не устанавливает дозу, длительность, доступ к улью или исход конкретной сцены.","search_aliases":["дым маскирует тревожный феромон","пчёлы защищаются","окурить улей"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:static-bee-smoke-b09-smoke-can-temporarily-reduce-alarm-pheromone-perception-and-defense","locale":"en","runtime_text":"Smoke can temporarily reduce honey-bee alarm-pheromone perception and can reduce colony defense. This guarantees no calm, dose, duration, hive access, or concrete-scene outcome.","search_aliases":["smoke masks alarm pheromone","bee defense","smoke hive"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:static-bee-smoke-b09-smoke-can-prompt-honey-engorgement-without-guaranteeing-calm","locale":"ru","runtime_text":"Дым может побудить пчёл набирать мёд и снизить вероятность ужаления, но не гарантирует, что все пчёлы останутся спокойны. Это не устанавливает запас, поведение каждой пчелы, безопасность или исход конкретной семьи.","search_aliases":["пчёлы набирают мёд от дыма","пчёлы всё ещё активны","дым и ужаления"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:static-bee-smoke-b09-smoke-can-prompt-honey-engorgement-without-guaranteeing-calm","locale":"en","runtime_text":"Smoke can prompt honey bees to engorge on honey and reduce stinging likelihood, but does not guarantee that all bees remain calm. This establishes no stores, individual behavior, safety, or outcome for a particular colony.","search_aliases":["bees gorge on honey","bees remain active","smoke and stinging"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:static-bee-smoke-b09-excessive-smoke-can-irritate-and-hot-smoke-is-unsuitable","locale":"ru","runtime_text":"Избыточный дым может раздражать пчёл; дым, слишком горячий для голой кожи, слишком горяч и для пчёл. Это не устанавливает температуру, дозу, ожог, травму или исход конкретной семьи.","search_aliases":["слишком много дыма пчёлы","горячий дым","раздражение пчёл"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:static-bee-smoke-b09-excessive-smoke-can-irritate-and-hot-smoke-is-unsuitable","locale":"en","runtime_text":"Excessive smoke can irritate bees; smoke too hot for bare skin is too hot for bees. This establishes no temperature, dose, burn, injury, or outcome for a particular colony.","search_aliases":["too much smoke bees","hot smoke","bee irritation"]}
