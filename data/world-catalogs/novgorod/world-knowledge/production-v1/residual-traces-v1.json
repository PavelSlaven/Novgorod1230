  "evidence": [
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:residual-traces-animal-trace-types",
      "source_ref": "source:residual-traces-unh-signs",
      "anchor": {
        "section": "Look for animal signs"
      },
      "note": "The source lists footprints, disturbed leaves/soil, holes, chewed leaves, scat and scratches as animal signs. This is a set of possible sign types, not an identification key or local occurrence.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:residual-traces-deadwood-feeding-signs",
      "source_ref": "source:residual-traces-unh-signs",
      "anchor": {
        "section": "Hints; example photos"
      },
      "note": "Dead trees house insects; birds feeding on these insects can leave signs in the wood. Avoid identifying any hole as a particular bird or claiming every dead tree is occupied.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:residual-traces-animal-trace-weather-decay",
      "source_ref": "source:residual-traces-maine-decay",
      "anchor": {
        "section": "Background Information for Facilitators; Elaborate"
      },
      "note": "Time/disturbance decay signs: feathers blow away, weather/traffic wear down footprints, and scat decomposes into soil. No numerical decay clock is supplied.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:residual-traces-animal-sign-absence-limit",
      "source_ref": "source:residual-traces-maine-decay",
      "anchor": {
        "section": "Background Information for Facilitators"
      },
      "note": "Inference from source's explicit decay and nonpermanence of traces: absence of surviving evidence cannot establish absence of earlier animal activity. This is an evidential limit, not presence or animal generation.",
      "review_status": "approved"
    }
