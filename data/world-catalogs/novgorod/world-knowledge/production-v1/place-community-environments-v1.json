  "concept_localizations": [
    {"schema":"world_knowledge_concept_localization_v1","concept_ref":"wk:social_law_economy:reconstructed-community-environment","locale":"ru","labels":["Общественная среда и договорённость"],"short_definition":"Условные связи людей, прохода, вещей и временной координации в ordinary общественных ситуациях.","search_aliases":["проход","очередь","семейные вещи","обоз","дозор"]},
    {"schema":"world_knowledge_concept_localization_v1","concept_ref":"wk:social_law_economy:reconstructed-community-environment","locale":"en","labels":["Community environment and agreement"],"short_definition":"Conditional links of people, passage, goods, and temporary coordination in ordinary public situations.","search_aliases":["passage","queue","household goods","convoy","watch"]}
