{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bounded_decision_result_v2",
  "type": "object",
  "required": ["version", "schema", "request_id", "state_version", "option_id", "command_token"],
  "properties": {
    "version": { "const": 2 },
    "schema": { "const": "bounded_decision_result_v2" },
    "request_id": { "type": "string", "minLength": 1 },
    "state_version": { "type": "integer", "minimum": 0 },
    "option_id": { "type": "string", "minLength": 1 },
    "command_token": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
