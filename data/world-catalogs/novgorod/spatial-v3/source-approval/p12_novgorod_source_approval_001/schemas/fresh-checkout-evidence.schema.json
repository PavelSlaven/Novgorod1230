{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fresh checkout evidence",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "repository",
    "commit_sha",
    "checkout",
    "tool_versions",
    "commands",
    "result_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "rus.fresh_checkout_evidence.v1"
    },
    "status": {
      "const": "completed_evidence"
    },
    "repository": {
      "const": "PavelSlaven/Novgorod1230"
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "checkout": {
      "type": "object",
      "required": [
        "fresh_clone",
        "clean_before",
        "clean_after"
      ],
      "properties": {
        "fresh_clone": {
          "const": true
        },
        "clean_before": {
          "const": true
        },
        "clean_after": {
          "const": true
        }
      }
    },
    "tool_versions": {
      "type": "object"
    },
    "commands": {
      "type": "array",
      "minItems": 1
    },
    "result_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true
}
