+void item_contents::combine_preserving_identity( item_contents &&read_input, const bool convert,
+        const bool into_bottom, bool ignore_contents )
+{
+    std::vector<std::pair<pocket_type, std::vector<item *>>> mismatched_pockets;
+    std::vector<item *> uninserted_items;
+    size_t pocket_index = 0;
+
+    for( item &pocket : read_input.additional_pockets ) {
+        add_pocket_preserving_identity( std::move( pocket ) );
+    }
+
+    for( item_pocket &pocket : read_input.contents ) {
+        if( pocket_index < contents.size() ) {
+            if( convert ) {
+                if( pocket.is_type( pocket_type::MIGRATION ) ||
+                    pocket.is_type( pocket_type::CORPSE ) ||
+                    pocket.is_type( pocket_type::MAGAZINE ) ||
+                    pocket.is_type( pocket_type::MAGAZINE_WELL ) ||
+                    pocket.is_type( pocket_type::E_FILE_STORAGE ) ) {
+                    ++pocket_index;
+                    for( item *it : pocket.all_items_top() ) {
+                        const ret_val<item *> inserted = insert_item_preserving_identity( std::move( *it ),
+                                pocket.get_pocket_data()->type, ignore_contents );
+                        if( !inserted.success() ) {
+                            uninserted_items.push_back( it );
+                        }
+                    }
+                    continue;
+                } else if( pocket.is_type( pocket_type::MOD ) ) {
+                    // skipping mod type pocket because using combine this way requires mods to come first
+                    // and to call update_mod_pockets
+                    ++pocket_index;
+                    continue;
+                }
+            } else {
+                if( pocket.saved_type() == pocket_type::MOD ) {
+                    // this is already handled in read_mods_preserving_identity
+                    ++pocket_index;
+                    continue;
+                } else if( pocket.saved_type() == pocket_type::MIGRATION ||
+                           pocket.saved_type() == pocket_type::CORPSE ) {
+                    for( item *it : pocket.all_items_top() ) {
+                        const ret_val<item *> inserted = insert_item_preserving_identity( std::move( *it ),
+                                pocket.saved_type(), ignore_contents );
+                        if( !inserted.success() ) {
+                            uninserted_items.push_back( it );
+                        }
+                    }
+                    ++pocket_index;
+                    continue;
+                }
+            }
+            auto current_pocket_iter = contents.begin();
+            std::advance( current_pocket_iter, pocket_index );
+
+            if( !current_pocket_iter->is_type( convert ? pocket.get_pocket_data()->type :
+                                               pocket.saved_type() ) ) {
+                const std::list<item *> items = pocket.all_items_top();
+                mismatched_pockets.emplace_back( convert ? pocket.get_pocket_data()->type : pocket.saved_type(),
+                        std::vector<item *>( items.begin(), items.end() ) );
+                continue;
+            }
+
+            for( item *it : pocket.all_items_top() ) {
+                const ret_val<item *> inserted = current_pocket_iter->insert_item_preserving_identity( std::move( *it ),
+                                                 into_bottom, ignore_contents );
+                if( !inserted.success() ) {
+                    uninserted_items.push_back( it );
+                }
+            }
+
+            if( pocket.saved_sealed() ) {
+                current_pocket_iter->seal();
+            }
+            current_pocket_iter->settings = pocket.settings;
+        } else {
+            for( item *it : pocket.all_items_top() ) {
+                uninserted_items.push_back( it );
+            }
+        }
+        ++pocket_index;
+    }
+
+    for( const auto &mismatch : mismatched_pockets ) {
+        for( item *it : mismatch.second ) {
+            const ret_val<item *> inserted = insert_item_preserving_identity( std::move( *it ), mismatch.first, ignore_contents );
+            if( !inserted.success() ) {
+                uninserted_items.push_back( it );
+            }
+        }
+    }
+
+    for( item *uninserted_item : uninserted_items ) {
+        const ret_val<item *> migrated = insert_item_preserving_identity( std::move( *uninserted_item ),
+                                                pocket_type::MIGRATION, ignore_contents );
+        if( !migrated.success() ) {
+            debugmsg( "error: item %s cannot fit into migration pocket while loading: %s",
+                      uninserted_item->typeId().str(), migrated.str() );
+        }
+    }
+}
