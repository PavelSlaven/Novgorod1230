+static int footprint_direction_index( const tripoint_abs_ms &old_pos,
+                                      const tripoint_abs_ms &new_pos )
+{
+    switch( direction_from( old_pos.xy(), new_pos.xy() ) ) {
+        case direction::NORTH:
+            return 0;
+        case direction::NORTHWEST:
+        case direction::WEST:
+        case direction::SOUTHWEST:
+            return 1;
+        case direction::SOUTH:
+            return 2;
+        case direction::NORTHEAST:
+        case direction::EAST:
+        case direction::SOUTHEAST:
+            return 3;
+        default:
+            return 2;
+    }
+}
+
+static void leave_ordinary_footprint( const Creature &creature,
+                                     const tripoint_abs_ms &old_pos,
+                                     const tripoint_abs_ms &new_pos )
+{
+    if( creature.is_fake() || ( old_pos.x() == new_pos.x() && old_pos.y() == new_pos.y() ) ) {
+        return;
+    }
+
+    map &here = get_map();
+    const tripoint_bub_ms old_tile = here.get_bub( old_pos );
+    if( !here.inbounds( old_tile ) || !here.has_floor( old_tile ) ||
+        here.has_flag( ter_furn_flag::TFLAG_SWIMMABLE, old_tile ) ) {
+        return;
+    }
+    if( !here.has_flag_ter( "SOFT_GROUND", old_tile ) &&
+        !( here.is_outside( old_tile ) && !here.is_roofed( old_tile ) &&
+           get_weather().get_snow_depth_mm( project_to<coords::omt>( old_pos ) ) > 0 ) ) {
+        return;
+    }
+
+    static const std::array<std::array<field_type_str_id, 4>, 3> footprints_by_family = {{
+            { fd_human_footprint_n, fd_human_footprint_w,
+              fd_human_footprint_s, fd_human_footprint_e },
+            { fd_bird_footprint_n, fd_bird_footprint_w,
+              fd_bird_footprint_s, fd_bird_footprint_e },
+            { fd_animal_footprint_n, fd_animal_footprint_w,
+              fd_animal_footprint_s, fd_animal_footprint_e }
+        }};
+    const int family = creature.in_species( species_HUMAN ) ? 0 :
+                       creature.in_species( species_BIRD ) ? 1 : 2;
+    const field_type_str_id &footprint = footprints_by_family[family][footprint_direction_index(
+                                              old_pos, new_pos )];
+    if( !footprint.is_valid() ) {
+        return;
+    }
+    if( here.get_field( old_tile, footprint ) != nullptr ) {
+        here.set_field_age( old_tile, footprint, 0_turns );
+        here.set_field_intensity( old_tile, footprint, 1 );
+    } else {
+        here.add_field( old_tile, footprint, 1, 0_turns, false );
+    }
+}
