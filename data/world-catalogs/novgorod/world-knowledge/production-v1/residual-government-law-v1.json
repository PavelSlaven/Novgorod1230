  "claim_localizations": [
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:residual-government-law-v1-1230-chronicle-names-archbishop-posadnik-and-tysyatsky","locale":"ru","runtime_text":"Летопись в кризисе 1230 года называет архиепископа Спиридона, посадника Водовика, а затем посадника Стефана Твердиславича и тысяцкого Никиту Петриловича. Это датированный ряд должностей, не правило их выбора, полномочий или текущие лица.","search_aliases":["Спиридон","Водовик","Стефан","Никита","тысяцкий"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:residual-government-law-v1-1230-records-veche-and-princely-oath-episode","locale":"ru","runtime_text":"Под 1230 годом НПЛ сообщает о вече на Ярославовом дворе и о клятве князя Ярослава на всех Ярославлих грамотах и всей воле новгородской. Это один кризисный эпизод, не конституционная схема.","search_aliases":["вече","Ярославов двор","грамоты","клятва"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:residual-government-law-v1-1220-1234-records-name-prussian-lyudin-and-nerev-ends","locale":"ru","runtime_text":"Летопись 1220–1234 годов называет Прусский, Людин и Неревский концы, а также Кузьмодемьянскую улицу. Эти записи не доказывают число концов, их дату, собрания или юрисдикцию.","search_aliases":["Прусский конец","Людин конец","Неревский конец","Кузьмодемьянская улица"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:residual-government-law-v1-1234-records-campaign-and-peace-with-germans","locale":"ru","runtime_text":"Под 1234 годом НПЛ описывает поход Ярослава и новгородцев против немцев и мир «на всей правде своей». Это один поход и соглашение, не постоянная внешняя политика или текущая граница.","search_aliases":["немцы","мир","1234","Ярослав"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:residual-government-law-v1-1229-records-whole-volost-and-envoys-to-yuri","locale":"ru","runtime_text":"Под 1229 годом НПЛ сообщает, что город собрал всю волость и послал послов к Юрию. Это один внешний эпизод, не постоянный представительный институт или суверенитет территории.","search_aliases":["волость","послы","Юрий","1229"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:residual-government-law-v1-1227-records-accusation-and-burning-episode","locale":"ru","runtime_text":"Под 1227 годом НПЛ сообщает, что четырёх обвинённых в волхвовании сожгли на Ярославовом дворе. Это запись об обвинении и насилии, не доказательство вины, законного суда или обычной санкции.","search_aliases":["волхвы","обвинение","сожжение","Ярославов двор"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:residual-government-law-v1-halperin-limits-sovereign-land-projection","locale":"ru","runtime_text":"Исследование Чарльза Халперина предостерегает от проекции современного суверенного государства на летописную «Новгородскую землю»: этот термин редок и не служит в летописях именем стороны войны или договора. Это интерпретационное ограничение, не описание текущей политики.","search_aliases":["Новгородская земля","суверенитет","Халперин"]}
  ]
