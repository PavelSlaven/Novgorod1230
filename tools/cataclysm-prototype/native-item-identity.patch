+ret_val<item *> item_pocket::insert_item_preserving_identity( item &&it,
+        const bool into_bottom, bool ignore_contents )
+{
+    ret_val<item_pocket::contain_code> containable = can_contain( it, ignore_contents );
+    if( !containable.success() ) {
+        return ret_val<item *>::make_failure( nullptr, containable.str() );
+    }
+
+    const units::volume item_volume = it.volume();
+    const units::mass item_weight = it.weight();
+    if( !into_bottom ) {
+        contents.push_front( std::move( it ) );
+    } else {
+        contents.push_back( std::move( it ) );
+    }
+    item *inserted = into_bottom ? &contents.back() : &contents.front();
+    if( bulk_fill_volume ) {
+        *bulk_fill_volume += item_volume;
+        *bulk_fill_weight += item_weight;
+    }
+    return ret_val<item *>::make_success( inserted );
+}
