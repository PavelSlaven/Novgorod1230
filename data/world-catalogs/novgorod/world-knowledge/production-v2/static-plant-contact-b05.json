  "evidence": [
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:static-plant-contact-straw-horse-bedding","source_ref":"source:static-plant-contact-rutgers-bedding","anchor":{"section":"Bedding Selection, lines 73–76"},"note":"Rutgers calls straw a traditional bedding source for horses. This does not establish a historical practice, human sleeping suitability, local straw, quantity, condition, access, or scene use.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:static-plant-contact-bedding-condition","source_ref":"source:static-plant-contact-rutgers-bedding","anchor":{"section":"Bedding Selection, lines 73–76"},"note":"Rutgers lists non-irritability, dust, texture, and dry storage among horse-bedding considerations. Generalising these material-condition considerations beyond horses is an inferred, medium-confidence premise; it does not make any grass, reed, or straw safe or suitable for human bedding.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:static-plant-contact-ranunculaceae-fresh-sap","source_ref":"source:static-plant-contact-cornell-ranunculosides","anchor":{"section":"Toxic Properties; Safety, lines 25–37"},"note":"Cornell says fresh Ranunculaceae sap may redden, swell, or blister skin. This establishes no species, specimen, contact, exposure amount, injury, allergy, ingestion, treatment, or outcome.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:static-plant-contact-phragmites-native-range","source_ref":"source:static-plant-contact-kew-phragmites","anchor":{"section":"Distribution"},"note":"Kew lists Phragmites australis as native in Central, North, and Northwest European Russia. Modern distribution is compatibility context only, not medieval local presence, stand, stock, access, harvest, or use.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:static-plant-contact-ranunculus-scel-native-range","source_ref":"source:static-plant-contact-kew-ranunculus-scel","anchor":{"section":"Distribution, lines 45–68"},"note":"Kew lists Ranunculus sceleratus as native in North and Northwest European Russia. Modern distribution is compatibility context only, not medieval local presence, specimen identity, contact, or hazard in a scene.","review_status":"approved"}
