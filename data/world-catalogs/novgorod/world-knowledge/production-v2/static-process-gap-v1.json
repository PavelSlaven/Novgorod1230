  "evidence": [
    { "schema": "world_knowledge_evidence_v1", "evidence_ref": "evidence:static-process-forge-contact-heat-pressure", "source_ref": "source:static-process-asm-forge-welding", "anchor": { "section": "Forge Welding, lines 376--378" }, "note": "ASM states the normal sequence: pressure seats faying surfaces, heat brings the joint to welding temperature, then additional pressure upsets the weld zone. It supplies no historical equipment, alloy, exact temperature, pressure, time or successful joint.", "review_status": "approved" },
    { "schema": "world_knowledge_evidence_v1", "evidence_ref": "evidence:static-process-forge-surface-oxide", "source_ref": "source:static-process-twi-forge-welding", "anchor": { "section": "Temperature, lines 516--517" }, "note": "TWI says weld surfaces need to be clean and that oxides may form; flux prevents oxidation that would create a poor-quality weld. This is conditional surface-process evidence, not a required flux recipe or a claim about a concrete surface.", "review_status": "approved" },
    { "schema": "world_knowledge_evidence_v1", "evidence_ref": "evidence:static-process-forge-pressure-depends-material", "source_ref": "source:static-process-twi-forge-welding", "anchor": { "section": "How does it work?, line 474" }, "note": "TWI states that required forge-welding pressure depends on heating temperature, hardness and strength of the materials. It supplies no numeric force or result for any object.", "review_status": "approved" },
    { "schema": "world_knowledge_evidence_v1", "evidence_ref": "evidence:static-process-wool-felting", "source_ref": "source:static-process-cci-textiles", "anchor": { "section": "Most common textile fibres — Natural fibres — Wool, lines 122--123" }, "note": "CCI states that wool scales can become interlocked in felting with moisture, heat and mechanical action. The source does not establish wool, all three conditions, degree of felting, damage or a current textile.", "review_status": "approved" },
    { "schema": "world_knowledge_evidence_v1", "evidence_ref": "evidence:static-process-lubricant-film-separation", "source_ref": "source:static-process-skf-lubrication-wear", "anchor": { "section": "Summary, lines 20--25" }, "note": "SKF states that good lubrication uses a film separating moving surfaces. It is not evidence that a specific axle or bearing has lubrication, a film, or low friction.", "review_status": "approved" },
    { "schema": "world_knowledge_evidence_v1", "evidence_ref": "evidence:static-process-asperity-contact-wear", "source_ref": "source:static-process-skf-lubrication-wear", "anchor": { "section": "Summary, lines 30--31 and 37--43" }, "note": "SKF says asperities penetrating an oil film make direct metal contact, producing high local stress and wear or plastic deformation; changed load or speed can bring new asperities into contact. No wear rate, clearance, material, lubricant or failure is established.", "review_status": "approved" },
    { "schema": "world_knowledge_evidence_v1", "evidence_ref": "evidence:static-process-nonhydraulic-lime-carbonation", "source_ref": "source:static-process-historic-england-lime", "anchor": { "section": "Mortars for Conservation webinar, lines 163--166" }, "note": "Historic England states that non-hydraulic lime sets by reaction with air and calcium hydroxide absorbs carbon dioxide to become calcium carbonate. This does not set a mortar mix, cure duration, weather or masonry result.", "review_status": "approved" },
    { "schema": "world_knowledge_evidence_v1", "evidence_ref": "evidence:static-process-hydraulic-lime-water-crystals", "source_ref": "source:static-process-historic-england-lime", "anchor": { "section": "Mortars for Conservation webinar, lines 164--168" }, "note": "Historic England states that with sufficient water, calcium silicates and aluminates in hydraulic lime form interlocking crystals responsible for initial setting. It does not identify a concrete lime, water amount, mix, cure or result.", "review_status": "approved" },
    { "schema": "world_knowledge_evidence_v1", "evidence_ref": "evidence:static-process-wood-ash-variable-ph", "source_ref": "source:static-process-umaine-wood-ash", "anchor": { "section": "Bulletin 2279, pp. 3--5, lines 108--112 and 150--159" }, "note": "UMaine uses calcium-carbonate equivalence to compare wood ash pH-raising effect and reports substantial differences among ash samples. It supplies neither a lye concentration nor an oil-cleaning result.", "review_status": "approved" },
    { "schema": "world_knowledge_evidence_v1", "evidence_ref": "evidence:static-process-wood-ash-contact-irritation", "source_ref": "source:static-process-umaine-wood-ash", "anchor": { "section": "Bulletin 2279, p. 5, lines 305--315" }, "note": "UMaine says ash can cause skin and eye irritation. This is a contact-risk relation, not proof of exposure, injury, cleaning compatibility or a required protective item.", "review_status": "approved" }
  ],
