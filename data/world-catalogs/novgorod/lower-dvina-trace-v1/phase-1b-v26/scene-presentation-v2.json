    {
      "location_ref": "trace_ld_v1_loc_wreck_shore",
      "display_name": "берег крушения",
      "player_visible_physical_facts": [
        "Мокрый песок и ивняк тянутся вдоль берега реки.",
        "У самой воды лежат разбитые доски и обрывки снастей.",
        "Над открытым берегом тянется низкое сырое небо."
      ],
      "source_basis": "stable_authoritative_location_environment"
    },
    {
      "location_ref": "trace_ld_v1_loc_fishing_camp",
      "display_name": "рыбацкий стан",
      "player_visible_physical_facts": [
        "На сухом берегу стоят навес и очаговая площадка.",
        "Под навесом есть место укрыться от речной сырости.",
        "От стана видна вода Нижней Двины.",
        "Сухой песчаный берег тянется вдоль воды.",
        "Сети развешены на кольях и между навесами.",
        "Лодки стоят у воды.",
        "Под навесом сложены свёрнутые снасти.",
        "В воздухе держится речная сырость."
      ],
      "source_basis": "stable_authoritative_location_environment"
    },
    {
      "location_ref": "trace_ld_v1_loc_old_drying_shed",
      "display_name": "старая сушильня",
      "player_visible_physical_facts": [
        "Старая сушильня стоит на сухом пригорке над сырой низиной.",
        "Доски стен дают полное укрытие от ветра.",
        "Вход в сушильню виден с тропы."
      ],
      "source_basis": "stable_authoritative_location_environment"
    },
    {
      "location_ref": "trace_ld_v1_loc_zhdanko_storehouse",
      "display_name": "клеть Жданко",
      "player_visible_physical_facts": [
        "Деревянная клеть стоит на приподнятой площадке у протоки.",
        "Площадка сухо поднимается над береговой травой.",
        "У протоки слышна тихая вода."
      ],
      "source_basis": "stable_authoritative_location_environment"
    }
  ],
  "fact_presentations": [
    {
