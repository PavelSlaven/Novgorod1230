  "claim_localizations": [
    {"schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:place-milk-acid-or-enzymic-coagulation-can-form-curd", "locale": "ru", "runtime_text": "Подкисление молока либо действие молокосвёртывающих ферментов могут образовать сгусток. Это не устанавливает молоко, кислоту, фермент, рецепт, длительность, безопасность или результат конкретной партии.", "search_aliases": ["свёртывание молока", "молочный сгусток"]},
    {"schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:place-milk-acid-or-enzymic-coagulation-can-form-curd", "locale": "en", "runtime_text": "Milk acidification or milk-clotting enzymes can form a curd. This establishes no milk, acid, enzyme, recipe, duration, safety, or result for a particular batch.", "search_aliases": ["milk coagulation", "milk curd"]},
    {"schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:place-milk-fresh-curd-can-progressively-separate-from-whey", "locale": "ru", "runtime_text": "Свежий молочный сгусток может постепенно разделяться на творожную часть и сыворотку, между которыми распределяются компоненты молока. Это не задаёт скорость, количество, выход, плотность, съедобность или состояние конкретного сосуда.", "search_aliases": ["отделение сыворотки", "творог", "сыворотка"]},
    {"schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:place-milk-fresh-curd-can-progressively-separate-from-whey", "locale": "en", "runtime_text": "A fresh milk coagulum can progressively separate into curd and whey, with milk components partitioned between them. This fixes no rate, amount, yield, firmness, edibility, or state of a particular vessel.", "search_aliases": ["whey separation", "curd", "whey"]},
    {"schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:place-milk-permeable-straining-support-can-retain-curd-while-whey-drains", "locale": "ru", "runtime_text": "Если уже есть сгусток и проницаемая основа для отцеживания, она может удерживать творожную часть, пока сыворотка стекает. Это editorial reconstruction, не наличие ткани или сита, не обязательный приём, не рецепт и не обещание отделения.", "search_aliases": ["отцеживание творога", "сыворотка", "сито"]},
    {"schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:place-milk-permeable-straining-support-can-retain-curd-while-whey-drains", "locale": "en", "runtime_text": "Where a curd and a permeable straining support are established, the support can retain curd while whey drains away. This is editorial reconstruction, not an available cloth or sieve, required method, recipe, or separation guarantee.", "search_aliases": ["curd straining", "whey", "sieve"]},
    {"schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:place-dye-textile-preparation-can-affect-uptake-evenness", "locale": "ru", "runtime_text": "Подготовка текстиля может влиять на поглощение красителя, а недостаточная очистка может способствовать пятнистому поглощению. Это не устанавливает загрязнение, вид волокна, краситель, ванну, цвет или результат окраски.", "search_aliases": ["подготовка ткани", "пятнистая окраска", "поглощение красителя"]},
    {"schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:place-dye-textile-preparation-can-affect-uptake-evenness", "locale": "en", "runtime_text": "Textile preparation can affect dye uptake, and inadequate cleaning can contribute to blotchy uptake. This establishes no contamination, fibre, dye, bath, colour, or dyeing result.", "search_aliases": ["textile preparation", "blotchy dyeing", "dye uptake"]},
    {"schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:place-dye-bath-to-fibre-transfer-can-change-with-process-conditions", "locale": "ru", "runtime_text": "В уже идущем процессе крашения краситель может переходить из ванны в волокно; его поглощение может меняться с временем контакта, температурой и сочетанием конкретных красителя и волокна. Остывание меняет одно из этих условий, но само по себе не доказывает количество поглощения, закрепление или ровность цвета и не даёт общего знака изменения.", "search_aliases": ["переход красителя в волокно", "температура красильной ванны", "поглощение красителя"]},
    {"schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:place-dye-bath-to-fibre-transfer-can-change-with-process-conditions", "locale": "en", "runtime_text": "In an established dyeing process, dye material can transfer from bath to fibre; its uptake can change with contact time, temperature, and the particular dye–fibre combination. Cooling changes one such condition but alone proves neither uptake amount, fixation, nor colour evenness and gives no general direction of change.", "search_aliases": ["dye transfer to fibre", "dye bath temperature", "dye uptake"]},
    {"schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:place-dye-moving-submerged-textile-can-support-even-contact", "locale": "ru", "runtime_text": "Если ванна и погружённый текстиль уже установлены, перемещение текстиля может поддержать контакт раствора с разными его частями, но не гарантирует ровный цвет. Это editorial reconstruction, не обязательный приём, скорость, инструмент, краситель, ванна или исход.", "search_aliases": ["перемешивание красильной ванны", "ровная окраска", "ткань в ванне"]},
    {"schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:place-dye-moving-submerged-textile-can-support-even-contact", "locale": "en", "runtime_text": "Where a dye bath and submerged textile are established, moving the textile can support contact across its portions but does not guarantee even colour. This is editorial reconstruction, not a required method, speed, tool, dye, bath, or outcome.", "search_aliases": ["dye bath movement", "even dyeing", "textile in bath"]}
  ]
}
