  "type_rules": [
    {
      "rule_id": "trace_ld_v1_rule_fact_independent_of_discovery",
      "record_type": "fact",
      "requires_source_ref": true,
      "invariant": "fact_exists_independently_of_discovery"
    },
    {
      "rule_id": "trace_ld_v1_rule_perception_from_available_observation",
      "record_type": "perception",
      "requires_source_ref": true,
      "allowed_source_types": [
        "direct_perception"
      ],
      "invariant": "perception_requires_available_observation"
    },
    {
      "rule_id": "trace_ld_v1_rule_knowledge_has_admitted_source",
      "record_type": "knowledge",
      "requires_source_ref": true,
      "allowed_source_types": [
        "direct_perception",
        "received_message",
        "received_instruction",
        "own_action",
        "own_instruction",
        "own_intention",
        "prior_admitted_perception_or_message",
        "derived_from_admitted_knowledge",
        "approved_own_schedule_binding",
        "approved_own_decision_binding"
      ],
      "invariant": "knowledge_requires_perception_message_or_other_admitted_source"
    },
    {
      "rule_id": "trace_ld_v1_rule_hypothesis_never_fact",
      "record_type": "hypothesis",
      "requires_source_ref": true,
      "invariant": "hypothesis_cannot_change_or_be_reclassified_as_fact"
    },
    {
      "rule_id": "trace_ld_v1_rule_rumor_requires_confirmation",
      "record_type": "rumor",
      "requires_source_ref": true,
      "invariant": "rumor_does_not_become_knowledge_without_confirmation"
    },
    {
      "rule_id": "trace_ld_v1_rule_false_assertion_preserves_fact",
      "record_type": "false_assertion",
      "requires_source_ref": true,
      "invariant": "false_assertion_cannot_change_fact"
    },
    {
      "rule_id": "trace_ld_v1_rule_memory_has_prior_event",
      "record_type": "memory",
      "requires_source_ref": true,
      "allowed_source_types": [
        "prior_admitted_perception_or_message",
        "own_action",
        "own_statement"
      ],
      "invariant": "memory_requires_prior_occurred_or_perceived_event"
    },
    {
      "rule_id": "trace_ld_v1_rule_player_facing_projection",
      "record_type": "player_facing_text",
      "requires_source_ref": true,
      "allowed_source_types": [
        "direct_perception",
        "received_message",
        "derived_from_admitted_knowledge"
      ],
      "forbidden_source_classes": [
        "hidden_truth",
        "candidate_id",
        "future_event",
        "unperceived_fact"
      ],
      "invariant": "player_facing_text_uses_only_allowed_perception_and_knowledge_package"
    }
  ],
