{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scene profile assignments",
  "type": "object",
  "required": [
    "schema_version",
    "records"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "canonical_g5_id",
          "legacy_g4_id",
          "source_profile_family_id",
          "scene_profile_ref",
          "scene_template_ref",
          "scene_materialization_allowed",
          "external_route_availability",
          "legacy_candidate_allowed",
          "status"
        ],
        "properties": {
          "canonical_g5_id": {
            "$ref": "#/$defs/stable_id"
          },
          "legacy_g4_id": {
            "type": "string"
          },
          "source_profile_family_id": {
            "type": "string"
          },
          "scene_profile_ref": {
            "$ref": "#/$defs/versioned_ref"
          },
          "scene_template_ref": {
            "$ref": "#/$defs/versioned_ref"
          },
          "scene_materialization_allowed": {
            "const": true
          },
          "external_route_availability": {
            "enum": [
              "normal",
              "blocked_pending_external_boundary"
            ]
          },
          "legacy_candidate_allowed": {
            "type": "boolean"
          },
          "legacy_forbidden_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "resolution_note": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "$ref": "#/$defs/status_approved"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status_approved": {
      "const": "approved"
    },
    "versioned_ref": {
      "type": "string",
      "pattern": "^[^@]+@[^@]+$"
    },
    "transformed_ref": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "canonical_g5",
            "retained_g3_with_host_g4",
            "retained_g2",
            "retained_g1"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "host_g4_id": {
          "type": "string"
        },
        "entry_canonical_g5_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
