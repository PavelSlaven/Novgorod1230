+void set_novgorod_test_adjacent_selection( int64_t actor_id, const tripoint_bub_ms &origin,
+        const tripoint_rel_ms &direction )
+{
+    if( !test_mode ) {
+        throw std::logic_error( "Novgorod adjacent selection requires test_mode" );
+    }
+    if( actor_id <= 0 || direction.x() < -1 || direction.x() > 1 ||
+        direction.y() < -1 || direction.y() > 1 || direction.z() < -1 || direction.z() > 1 ||
+        ( direction.x() == 0 && direction.y() == 0 && direction.z() == 0 ) ) {
+        throw std::invalid_argument( "NOVGOROD_TEST_ADJACENT_SELECTION_INVALID" );
+    }
+    novgorod_test_adjacent_selection = novgorod_adjacent_selection{ actor_id, origin, direction };
+    novgorod_test_adjacent_selection_required = true;
+}
+
+void require_novgorod_test_adjacent_selection()
+{
+    if( !test_mode ) {
+        throw std::logic_error( "Novgorod adjacent selection requires test_mode" );
+    }
+    novgorod_test_adjacent_selection_required = true;
+}
+
+void clear_novgorod_test_adjacent_selection()
+{
+    novgorod_test_adjacent_selection.reset();
+    novgorod_test_adjacent_selection_required = false;
+}
