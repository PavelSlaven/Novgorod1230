  "evidence": [
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:v2-g2-birch-letter-authors-wide-range",
      "source_ref": "source:book-641351",
      "anchor": {
        "section": "БЕРЕСТЯНЫЕ ГРАМОТЫ > КОММЕНТАРИЙ",
        "record_id": "book:641351"
      },
      "note": "«В переписке на бересте принимали участие женщины»; авторы грамот — «домовладельцы, купцы, старосты, ключники, ремесленники, воины» — переписка на бересте велась людьми самых разных занятий, включая женщин.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:v2-g2-literacy-notable-but-not-universal",
      "source_ref": "source:book-624953",
      "anchor": {
        "section": "Глава 7 Новгородские берестяные грамоты В.Л. Янин",
        "record_id": "book:624953"
      },
      "note": "«Грамотные люди имелись в Новгороде в заметном числе»; но, добавляет то же место, грамотность «была далеко не всеобщей» — грамотных в городе много, но не всякий горожанин читает и пишет.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:v2-g2-body-carried-on-sled-any-season",
      "source_ref": "source:book-641342",
      "anchor": {
        "section": "[notes] > 505",
        "record_id": "book:641342"
      },
      "note": "«Вынос тела через разобранную крышу и перевозка покойника на санях (в любое время года) — элементы древнерусского похоронного обряда» — так покойного несут из дома и везут к месту погребения, независимо от того, лето это или зима.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:v2-g2-feasts-at-funerals-weddings-tonsures",
      "source_ref": "source:book-678341",
      "anchor": {
        "section": "Часть первая ЖИЗНЬ ДРЕВНИХ СЛАВЯН ОТ КОЛЫБЕЛИ ДО МОГИЛЫ > V. ПИЩА И НАПИТКИ",
        "record_id": "book:678341"
      },
      "note": "«Званые угощения были обычны при семейных событиях, как-то: свадьбах, постригах или похоронах» — после похорон, как и после свадьбы или пострига, устраивают угощение для родни и соседей.",
      "review_status": "approved"
    }
  ],
