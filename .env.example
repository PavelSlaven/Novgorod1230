RUS_MODULES_ENABLED=true
RUS_UI_MODULES_ENABLED=true
RUS_COMPOSITION_MODULE=builtin:production
RUS_RUNTIME_BINDINGS_MODULE=./runtime-bindings.js
RUS_SERVER_HOST=127.0.0.1
RUS_SERVER_PORT=3000
RUS_WORLD_DATABASE_URL=postgresql://rus_world_reader:change-me@127.0.0.1:5432/rus_world
RUS_PARTY_DATABASE_URL=postgresql://rus_party_writer:change-me@127.0.0.1:5432/rus_party
RUS_DATABASE_SSL=false
RUS_RUN_PARTY_MIGRATIONS=true
RUS_PROBE_LLM_PROVIDER_ON_STARTUP=false
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
PORTRAIT_SPEC_NORMALIZER_MODEL=deepseek-v4-flash

# Canonical documentation corpus and generated representations.
RUS_KNOWLEDGE_SOURCE_ROOT=./data/knowledge-source
RUS_GENERATED_KNOWLEDGE_ROOT=./generated/knowledge-source
