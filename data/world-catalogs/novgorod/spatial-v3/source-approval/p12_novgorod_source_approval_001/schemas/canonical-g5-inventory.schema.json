{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical G5 inventory",
  "type": "object",
  "required": [
    "schema_version",
    "records"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "parent_g4_id",
          "class_id",
          "origin",
          "title",
          "spatial_function_id",
          "evidence_status",
          "legacy_record_ref",
          "migration_action",
          "scene_materialization_profile_ref",
          "external_route_availability",
          "status",
          "provenance_ref"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/stable_id"
          },
          "version": {
            "$ref": "#/$defs/version"
          },
          "parent_g4_id": {
            "$ref": "#/$defs/stable_id"
          },
          "class_id": {
            "const": "spatial.g5.parcel"
          },
          "origin": {
            "const": "canonical"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "name_status": {
            "type": "string"
          },
          "spatial_function_id": {
            "type": "string",
            "minLength": 1
          },
          "function": {
            "type": "string",
            "minLength": 1
          },
          "permanence": {
            "type": "string"
          },
          "access_rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "seasonal_use": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hazards": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_status": {
            "type": "string",
            "minLength": 1
          },
          "reconstruction_method": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "legacy_record_ref": {
            "type": "object",
            "required": [
              "kind",
              "id",
              "content_revision"
            ],
            "properties": {
              "kind": {
                "const": "legacy_g4"
              },
              "id": {
                "type": "string"
              },
              "content_revision": {
                "const": "content_revision_002"
              }
            },
            "additionalProperties": false
          },
          "migration_action": {
            "const": "reclassify"
          },
          "migration_reason": {
            "type": "string",
            "minLength": 1
          },
          "scene_materialization_profile_ref": {
            "$ref": "#/$defs/versioned_ref"
          },
          "external_route_availability": {
            "enum": [
              "normal",
              "blocked_pending_external_boundary"
            ]
          },
          "status": {
            "$ref": "#/$defs/status_approved"
          },
          "provenance_ref": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status_approved": {
      "const": "approved"
    },
    "versioned_ref": {
      "type": "string",
      "pattern": "^[^@]+@[^@]+$"
    },
    "transformed_ref": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "canonical_g5",
            "retained_g3_with_host_g4",
            "retained_g2",
            "retained_g1"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "host_g4_id": {
          "type": "string"
        },
        "entry_canonical_g5_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
