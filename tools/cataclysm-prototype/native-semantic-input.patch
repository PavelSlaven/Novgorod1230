+void require_novgorod_test_adjacent_selection()
+{
+    if( !test_mode ) {
+        throw std::logic_error( "Novgorod adjacent selection requires test_mode" );
+    }
+    novgorod_test_adjacent_selection_required = true;
+}
+
+void clear_novgorod_test_adjacent_selection()
+{
+    novgorod_test_adjacent_selection.reset();
+    novgorod_test_adjacent_selection_required = false;
