{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CommitGateReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commit_allowed",
    "blocking_issue_count",
    "warning_count",
    "rollback_required",
    "decision_reason"
  ],
  "properties": {
    "commit_allowed": {
      "type": "boolean"
    },
    "blocking_issue_count": {
      "type": "integer"
    },
    "warning_count": {
      "type": "integer"
    },
    "committed_revision": {
      "type": [
        "integer",
        "null"
      ]
    },
    "rollback_required": {
      "type": "boolean"
    },
    "decision_reason": {
      "type": "string"
    }
  }
}