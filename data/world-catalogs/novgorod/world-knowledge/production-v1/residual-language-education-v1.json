  "evidence": [
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:residual-v1-household-official-registers","source_ref":"source:candidate-v5-zaliznyak-general-information","anchor":{"section":"Содержание, специфические трудности изучения","record_id":"household-and-official-registers"},"note":"Zaliznyak distinguishes household letters, normally dialectal, from official documents, which usually orient to supradialectal Old-Russian norms but can retain dialectisms. This is a corpus distinction, not a rule for a particular speaker, document, or 1230 scene.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:residual-v1-church-text-language","source_ref":"source:candidate-v5-zaliznyak-general-information","anchor":{"section":"Содержание, специфические трудности изучения","record_id":"church-text-language-variation"},"note":"Zaliznyak says church texts and listed charms are in pure Church Slavonic in some cases and mixed language in others. This does not assign a register, belief, literacy, or utterance to an actor.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:residual-v1-reading-uncertainty","source_ref":"source:candidate-v5-zaliznyak-general-information","anchor":{"section":"Содержание, специфические трудности изучения","record_id":"fragmentary-reading-and-interpretation-revisions"},"note":"The source explains that many texts are damaged, letter identification can be uncertain, and later study can revise readings and translations. This bounds use of the corpus; it is not a claim that any particular text is unreadable or false.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:residual-v1-name-only-labels","source_ref":"source:candidate-v5-zaliznyak-general-information","anchor":{"section":"Содержание, специфические трудности изучения","record_id":"name-only-owner-labels-function-disputed"},"note":"Zaliznyak reports about two dozen labels containing only an owner's name, while their function remains disputed. This does not establish a name inventory, patronymic convention, owner identity, or use in a scene.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:residual-v1-etiquette-formulas-dating","source_ref":"source:candidate-v5-zaliznyak-general-information","anchor":{"section":"Датирование","record_id":"etiquette-formulas-have-chronological-value"},"note":"Zaliznyak identifies the character of etiquette formulas in birch-bark letters as one chronological aid. This is not a reconstructed greeting, title, social hierarchy, or generated form of address.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:residual-v1-birch-writing-surface-stylus","source_ref":"source:candidate-v5-zaliznyak-general-information","anchor":{"section":"Внешний вид, нумерация","record_id":"birch-bark-inner-side-stylus-inscription"},"note":"The source describes letters as birch-bark sheets, generally written by pressing or scratching with a dedicated metal or bone stylus, most often on the inner side. This is corpus material practice, not the presence of a surface, stylus, or writer in a scene.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:residual-v1-private-letters-and-registers","source_ref":"source:candidate-v5-zaliznyak-general-information","anchor":{"section":"Содержание, специфические трудности изучения","record_id":"private-letters-and-practical-registers"},"note":"Zaliznyak describes the overwhelming majority as private letters on current household, family, monetary, and trade matters; he separately describes debt lists and money-or-kind supply registers. This is corpus composition, not a literacy rate, delivery system, or current account.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:residual-v1-register-function-range","source_ref":"source:candidate-v5-zaliznyak-general-information","anchor":{"section":"Содержание, специфические трудности изучения","record_id":"registers-memory-or-written-instructions"},"note":"The source says practical registers could be personal reminders or written instructions to collect specified debts. It does not show which function a particular record had, that a debt existed, or that collection succeeded.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:residual-v1-instructional-text-types","source_ref":"source:candidate-v5-zaliznyak-general-information","anchor":{"section":"Содержание, специфические трудности изучения","record_id":"instructional-alphabets-numeral-lists-syllables-exercises"},"note":"Zaliznyak lists alphabets, numeral lists, syllables, and exercises among the corpus's instructional texts. This attests text types only, not a school, teacher, pupil, curriculum, apprenticeship, or literacy distribution in 1230.","review_status":"approved"}
