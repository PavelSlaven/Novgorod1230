+{
+    const char *failpoint = std::getenv( "NOVGOROD_P4_FAILPOINT" );
+    const char *mode = std::getenv( "NOVGOROD_P4_MODE" );
+    if( !test_mode || failpoint == nullptr || std::string_view( failpoint ) != "mid_save" ||
+        mode == nullptr || ( std::string_view( mode ) != "create" &&
+                             std::string_view( mode ) != "apply" ) ) {
+        return;
+    }
+    static constexpr char marker[] = "NOVGOROD_P4_FAILPOINT_REACHED:mid_save\n";
+#if defined(_WIN32)
+    _write( _fileno( stdout ), marker, sizeof( marker ) - 1 );
+#else
+    ::write( STDOUT_FILENO, marker, sizeof( marker ) - 1 );
+#endif
+    for( ;; ) {
+        std::this_thread::sleep_for( std::chrono::milliseconds( 100 ) );
+    }
+}
