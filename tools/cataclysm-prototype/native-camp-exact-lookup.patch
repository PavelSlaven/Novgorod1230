+TEST_CASE( "mutable_camp_special_keeps_adjacent_camp_on_reload", "[novgorod_camp][overmap]" )
+{
+    overmap_buffer.clear();
+    const point_abs_om origin{ 0, 0 };
+    overmap_special_batch empty_specials( origin );
+    overmap_buffer.create_custom_overmap( origin, empty_specials );
+    overmap *om = overmap_buffer.get_existing( origin );
+    REQUIRE( om != nullptr );
+
+    const tripoint_om_omt new_local{ 80, 80, 0 };
+    om->ter_set( new_local, oter_id( "field" ) );
+    const tripoint_abs_omt old_pos{ project_combine( origin, point_om_omt{ 79, 79 } ), 0 };
+    const tripoint_abs_omt new_pos{ project_combine( origin, new_local.xy() ), 0 };
+    om->add_camp( old_pos.xy(), basecamp( "Previous camp", old_pos ) );
+
+    const overmap_special &special = *overmap_special_id( "test_adjacent_camp" );
+    const std::vector<tripoint_om_omt> placed = om->place_special(
+                special, new_local, om_direction::type::north, city{}, false, true );
+    REQUIRE_FALSE( placed.empty() );
+    REQUIRE( om->find_camp( old_pos.xy() ).has_value() );
+    REQUIRE( om->find_camp( new_pos.xy() ).has_value() );
+
+    std::stringstream saved;
+    om->serialize( saved );
+    std::unique_ptr<overmap> loaded = std::make_unique<overmap>( origin );
+    loaded->unserialize( saved );
+
+    CHECK_FALSE( debug_has_error_been_observed() );
+    std::optional<basecamp *> old_camp = loaded->find_camp( old_pos.xy() );
+    std::optional<basecamp *> new_camp = loaded->find_camp( new_pos.xy() );
+    REQUIRE( old_camp.has_value() );
+    REQUIRE( new_camp.has_value() );
+    CHECK( ( *old_camp )->camp_name() == "Previous camp" );
+    CHECK( ( *old_camp )->camp_omt_pos() == old_pos );
+    CHECK( ( *new_camp )->camp_name() == "New camp" );
+    CHECK( ( *new_camp )->camp_omt_pos() == new_pos );
+}
