    "g4_function_to_pf": {
      "rule": "Primary pf of a v17 G4 = map of its authoring_axes.function; the function axis is marked direct/high in the source. Unmapped or ambiguous functions stay a gap.",
      "map": {
        "channel_split": "river_channel",
