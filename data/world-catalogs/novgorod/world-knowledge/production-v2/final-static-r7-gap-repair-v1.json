  "claim_localizations": [
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:r7-stored-edible-or-lamp-oil-condition-can-change-with-age-air-or-contamination","locale":"ru","runtime_text":"Состояние уже имеющегося пищевого или лампового масла может меняться от времени, воздуха или загрязнения: прогорклый запах, необычный вкус либо осадок требуют осторожной оценки, но не доказывают причину, безопасность пищи или работу лампы.","search_aliases":["прогорклое масло","осадок в масле","испорченное ламповое масло"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:r7-stored-edible-or-lamp-oil-condition-can-change-with-age-air-or-contamination","locale":"en","runtime_text":"The condition of already present edible or lamp oil can change with age, air contact, or contamination: rancid odour, unusual taste, or sediment calls for caution without proving cause, food safety, or lamp function.","search_aliases":["rancid oil","oil sediment","spoiled lamp oil"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:r7-confined-low-ventilation-space-can-retain-harmful-or-oxygen-poor-air","locale":"ru","runtime_text":"Уже установленное замкнутое природное пространство со слабым проветриванием может удерживать вредный или бедный кислородом воздух; тускнеющее пламя либо недомогание — повод осторожно выйти, а не безопасная проба или определение газа.","search_aliases":["пещера гаснет огонь","душный воздух","выйти из пещеры"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:r7-confined-low-ventilation-space-can-retain-harmful-or-oxygen-poor-air","locale":"en","runtime_text":"An established confined natural space with low ventilation can retain harmful or oxygen-poor air; a dimming flame or discomfort is a cue to withdraw cautiously, not a safe test or gas identification.","search_aliases":["cave flame dims","stuffy air","leave cave"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:r7-acidic-wet-food-in-unlined-copper-contact-can-change-the-contact-surface","locale":"ru","runtime_text":"Кислая влажная пища в контакте с уже имеющейся нелужёной медной поверхностью может менять поверхность контакта; такой контакт не доказывает безопасное хранение или безопасный пищевой результат.","search_aliases":["кислая еда медная посуда","нелужёная медь","медь и пища"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:r7-acidic-wet-food-in-unlined-copper-contact-can-change-the-contact-surface","locale":"en","runtime_text":"Acidic wet food contacting an already present unlined copper surface can change the food-contact surface; that contact does not establish safe storage or a safe food result.","search_aliases":["acidic food copper pot","unlined copper","copper food contact"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:r7-unstable-layered-snow-on-a-slope-can-release-and-warning-cues-support-exposure-reduction","locale":"ru","runtime_text":"Неустойчивый слоистый снег на уже установленном склоне может сойти под тяжестью или дополнительной нагрузкой; предупреждающие признаки либо недавняя нагрузка — повод уменьшить воздействие, но не предсказание лавины, маршрута или исхода.","search_aliases":["лавина","снег на склоне","трещины в снегу"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:r7-unstable-layered-snow-on-a-slope-can-release-and-warning-cues-support-exposure-reduction","locale":"en","runtime_text":"Unstable layered snow on an established slope can release under gravity or added load; warning cues or recent loading support reducing exposure without predicting an avalanche, route, or outcome.","search_aliases":["avalanche","snow slope","snow cracks"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:r7-unusual-flame-colour-or-fume-can-support-unidentified-material-exposure-caution","locale":"ru","runtime_text":"Необычный цвет пламени или дым может быть связан с неизвестным материалом либо условием горения и оправдывает избегать вдыхания и прямого воздействия, но не определяет материал и не задаёт безопасный ответ на пожар.","search_aliases":["цвет пламени","едкий дым","неизвестное горит"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:r7-unusual-flame-colour-or-fume-can-support-unidentified-material-exposure-caution","locale":"en","runtime_text":"An unusual flame colour or fume can reflect an unidentified material or burning condition and supports avoiding inhalation or direct exposure without identifying the material or establishing a safe fire response.","search_aliases":["flame colour","irritating fumes","unknown material burns"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:r7-sealed-food-container-can-swell-when-gas-forms-or-warms","locale":"ru","runtime_text":"Уже имеющаяся закрытая тара с пищей может вздуться, когда образуется или нагревается газ; вздутие делает важными внутреннее давление и осторожное обращение, но не доказывает порчу и не задаёт способ вскрытия или результат.","search_aliases":["вздутая банка","вздутая тара","газ в закрытой еде"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:r7-sealed-food-container-can-swell-when-gas-forms-or-warms","locale":"en","runtime_text":"An already present sealed food container can swell when gas forms or warms; swelling makes internal pressure and cautious handling relevant without diagnosing spoilage or setting an opening method or outcome.","search_aliases":["swollen container","bulging jar","gas in sealed food"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:r7-polished-metal-can-reflect-directional-sunlight-with-condition-bound-visibility","locale":"ru","runtime_text":"Уже имеющаяся полированная металлическая поверхность может отражать направленный солнечный свет, но видимость зависит от света, ориентации, линии зрения и условий между наблюдателями; получатель, дальность и результат сигнала не заданы.","search_aliases":["зеркальный сигнал","блик металла","отразить солнце"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:r7-polished-metal-can-reflect-directional-sunlight-with-condition-bound-visibility","locale":"en","runtime_text":"An already present polished metal surface can reflect directional sunlight, but visibility depends on light, orientation, line of sight, and intervening conditions; it establishes no recipient, range, or signal result.","search_aliases":["mirror signal","metal glint","reflect sunlight"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:r7-poorly-ventilated-animal-housing-can-have-irritating-air-from-manure-and-urine","locale":"ru","runtime_text":"Плохо проветриваемое помещение для животных с навозом и мочой может иметь раздражающий воздух; запах либо раздражение глаз или дыхания оправдывает проветривание или выход, но не определяет химическое вещество и не ставит диагноз.","search_aliases":["хлев едкий запах","навоз раздражает глаза","проветрить хлев"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:r7-poorly-ventilated-animal-housing-can-have-irritating-air-from-manure-and-urine","locale":"en","runtime_text":"Poorly ventilated animal housing with manure and urine can have irritating air; odour or eye or airway discomfort supports ventilation or withdrawal without identifying a chemical or diagnosing exposure.","search_aliases":["barn pungent smell","manure eye irritation","ventilate stable"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:r7-possibly-frozen-body-part-needs-protection-from-further-cold-and-rough-warming-avoidance","locale":"ru","runtime_text":"Возможно замёрзшую часть тела нужно защищать от дальнейшего холода; грубое растирание или неконтролируемое согревание не являются надёжным ответом, но это не диагноз, лечение или обещание исхода.","search_aliases":["обморожение","не растирать снегом","замёрзшие пальцы"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:r7-possibly-frozen-body-part-needs-protection-from-further-cold-and-rough-warming-avoidance","locale":"en","runtime_text":"A possibly frozen body part needs protection from further cold; rough rubbing or uncontrolled heating is not a reliable response, without diagnosing injury or establishing treatment or outcome.","search_aliases":["frostbite","do not rub with snow","frozen fingers"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:r7-suspected-venomous-snakebite-supports-limiting-exertion-and-seeking-help","locale":"ru","runtime_text":"При подозрении на укус ядовитой змеи следует ограничить нагрузку и искать доступную помощь; разрезание, отсасывание или перетягивание конечности ненадёжны, а вид, тяжесть и исход остаются неизвестны.","search_aliases":["укус змеи","ядовитая змея","не накладывать жгут"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:r7-suspected-venomous-snakebite-supports-limiting-exertion-and-seeking-help","locale":"en","runtime_text":"A suspected venomous snakebite supports limiting exertion and seeking available help; cutting, sucking, or constricting the limb is not reliable, and species, severity, and outcome remain unknown.","search_aliases":["snakebite","venomous snake","do not use tourniquet"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:r7-fuelwood-combustion-depends-on-moisture-density-piece-size-and-air","locale":"ru","runtime_text":"Горение уже имеющихся дров зависит от влажности, плотности, размера кусков и воздуха; сухая плотная и сухая лёгкая древесина могут различаться по розжигу и характеру горения, но не задано ранжирование, запас, теплоотдача или результат.","search_aliases":["сухие дрова","твёрдая древесина","мягкая древесина","сырые дрова"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:r7-fuelwood-combustion-depends-on-moisture-density-piece-size-and-air","locale":"en","runtime_text":"Combustion of already present fuelwood depends on moisture, density, piece size, and air; dry dense and dry light woods can differ in ignition and burn character without a fixed ranking, fuel stock, heat output, or result.","search_aliases":["dry firewood","hardwood","softwood","wet wood"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:r7-repeated-wetting-rinsing-and-daylight-can-gradually-lighten-some-flax-linen","locale":"ru","runtime_text":"Повторное увлажнение или полоскание и дневной свет могут постепенно осветлять часть льняной ткани, но загрязнение, окраска, состояние волокна и погода не позволяют задать срок или гарантировать видимый результат.","search_aliases":["белить лён","солнце и лён","полоскать льняную ткань"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:r7-repeated-wetting-rinsing-and-daylight-can-gradually-lighten-some-flax-linen","locale":"en","runtime_text":"Repeated wetting or rinsing and daylight can gradually lighten some flax linen, while soil, dye, fibre condition, and weather prevent a fixed duration or guaranteed visible result.","search_aliases":["bleach linen","sun bleach flax","rinse linen"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:r7-gentle-warming-of-beeswax-comb-can-separate-some-liquid-wax-from-coarse-debris","locale":"ru","runtime_text":"Мягкое нагревание уже имеющихся содержащих воск сотов может позволить части жидкого воска отделиться от крупного мусора отстаиванием или процеживанием, но температура, оснащение, выход, чистота и полный способ не заданы.","search_aliases":["перетопить воск","очистить воск от сотов","воск и мусор"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:r7-gentle-warming-of-beeswax-comb-can-separate-some-liquid-wax-from-coarse-debris","locale":"en","runtime_text":"Gentle warming of already present beeswax-containing comb can allow some liquid wax to separate from coarse debris by settling or straining, without setting temperature, equipment, yield, purity, or a complete method.","search_aliases":["render beeswax","clean wax comb","wax debris"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:r7-potato-must-not-be-assumed-locally-available-in-novgorod-rus-1200-1300","locale":"ru","runtime_text":"Картофель нельзя предполагать местной пищей Новгорода/Руси 1200–1300: его упоминание — граница анахронизма, а не существующий урожай или пищевой запас.","search_aliases":["картофель 1230","картошка Новгород","анахронизм еды"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:r7-potato-must-not-be-assumed-locally-available-in-novgorod-rus-1200-1300","locale":"en","runtime_text":"Potato must not be assumed to be a locally available food in Novgorod/Rus in 1200–1300: its mention is an anachronism boundary, not a present crop or food stock.","search_aliases":["potato 1230","potatoes Novgorod","food anachronism"]}
