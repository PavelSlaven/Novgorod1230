+void json_loader::reset_path_caches_for_fork_test()
+{
+    base_cache().reset_paths( ( PATH_INFO::base_path() / "cache" ).get_unrelative_path(),
+                              PATH_INFO::base_path().get_unrelative_path() );
+    config_cache().reset_paths( ( PATH_INFO::config_dir_path() / "cache" ).get_unrelative_path(),
+                                PATH_INFO::config_dir_path().get_unrelative_path() );
+    data_cache().reset_paths( ( PATH_INFO::datadir_path() / "cache" ).get_unrelative_path(),
+                              PATH_INFO::datadir_path().get_unrelative_path() );
+    memorial_cache().reset_paths( ( PATH_INFO::memorialdir_path() / "cache" ).get_unrelative_path(),
+                                  PATH_INFO::memorialdir_path().get_unrelative_path() );
+    user_cache().reset_paths( ( PATH_INFO::user_dir_path() / "cache" ).get_unrelative_path(),
+                              PATH_INFO::user_dir_path().get_unrelative_path() );
+    save_caches.clear();
+}
 
