    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:rp-art29","source_ref":"source:russkaya-pravda-extended-msu","anchor":{"section":"article 29"},"note":"The text distinguishes an assertion of ownership from proceeding through a svod/acquisition chain for a lost or stolen thing.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:rp-art32","source_ref":"source:russkaya-pravda-extended-msu","anchor":{"section":"article 32"},"note":"The stated market-purchase clause names two free men or a mytnik in connection with a disputed thing.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:rp-art45","source_ref":"source:russkaya-pravda-extended-msu","anchor":{"section":"article 45"},"note":"The clause concerns goods placed for keeping and a later accusation about the amount placed.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:rp-art50","source_ref":"source:russkaya-pravda-extended-msu","anchor":{"section":"article 50"},"note":"The merchant clause distinguishes travel with another's kuna from loss by sinking, war, fire, or self-caused dissipation of another's goods.","review_status":"approved"},
