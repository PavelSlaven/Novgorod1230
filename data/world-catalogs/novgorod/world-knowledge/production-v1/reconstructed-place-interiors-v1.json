  "claim_localizations": [
    {
      "schema": "world_knowledge_claim_localization_v1",
      "claim_ref": "claim:reconstructed-dwelling-interior-shares-work-rest-and-passage-contextually",
      "locale": "ru",
      "runtime_text": "Жилая комната может держать у стен лавки или настилы с подстилкой; часть места занимает печь или очаг, вокруг которых оставляют рабочую зону и проход. Рядом могут стоять тара, свёртки или переносимые вещи. В тесноте часть дела уносят во двор, откладывают до света или делают по очереди; более обеспеченный дом может разделять занятия лучше, но единой планировки нет.",
      "search_aliases": [
        "тесный дом",
        "работа дома",
        "место для сна"
      ]
    },
    {
      "schema": "world_knowledge_claim_localization_v1",
      "claim_ref": "claim:reconstructed-dwelling-interior-shares-work-rest-and-passage-contextually",
      "locale": "en",
      "runtime_text": "A living room can keep benches or platforms with bedding by the walls; a stove or hearth takes part of the room, with work space and passage left around it. Containers, bundles, or movable goods may stand nearby. In crowding, work can move to the yard, wait for light, or be done in turns; a better-resourced household may divide activity more easily, but no single layout is required.",
      "search_aliases": [
        "crowded house",
        "work indoors",
        "sleeping space"
      ]
    },
    {
      "schema": "world_knowledge_claim_localization_v1",
      "claim_ref": "claim:reconstructed-dwelling-interior-light-and-air-change-with-opening-weather-and-fuel",
      "locale": "ru",
      "runtime_text": "Днём свет идёт от двери, окна или другого проёма, оставляя дальние углы темнее; вечером его дают очаг и доступный огонёк. Открытый проём выпускает дым, но вместе с ним впускает холод и дождь: при сыром топливе и тихом воздухе работа у очага, сон и разговор могут потребовать другого места или паузы.",
      "search_aliases": [
        "темно в доме",
        "дым в избе",
        "сквозняк"
      ]
    },
    {
      "schema": "world_knowledge_claim_localization_v1",
      "claim_ref": "claim:reconstructed-dwelling-interior-light-and-air-change-with-opening-weather-and-fuel",
      "locale": "en",
      "runtime_text": "By day, light comes through a door, window, or other opening, leaving farther corners darker; in the evening a hearth and available small flame provide it. An opening lets smoke out but also admits cold and rain: damp fuel and still air can make work, sleep, or conversation shift away from the hearth or pause.",
      "search_aliases": [
        "dark room",
        "house smoke",
        "draft"
      ]
    },
    {
      "schema": "world_knowledge_claim_localization_v1",
      "claim_ref": "claim:reconstructed-dwelling-interior-tasks-adjust-to-space-heat-and-attention",
      "locale": "ru",
      "runtime_text": "У очага удобнее греть пищу, сушить малую вещь или сидеть с больным, но тот же угол нужен топящему и может быть дымным. Прядение, починка, перебор припасов или разговор переносят к свету, на лавку, к двери либо во двор; нехватка места и приватности делает очередность и взаимную уступку частью обычного быта.",
      "search_aliases": [
        "дела у очага",
        "теснота",
        "уход дома"
      ]
    },
    {
      "schema": "world_knowledge_claim_localization_v1",
      "claim_ref": "claim:reconstructed-dwelling-interior-tasks-adjust-to-space-heat-and-attention",
      "locale": "en",
      "runtime_text": "The hearth corner suits warming food, drying a small item, or sitting with someone unwell, but it is also needed by the fire-tender and may be smoky. Spinning, mending, sorting stores, or conversation can move toward light, a bench, the doorway, or the yard; limited space and privacy make turns and mutual accommodation part of ordinary life.",
      "search_aliases": [
        "hearth work",
        "crowding",
        "care indoors"
      ]
    },
    {
      "schema": "world_knowledge_claim_localization_v1",
      "claim_ref": "claim:reconstructed-dwelling-moisture-and-routine-can-leave-changeable-traces",
      "locale": "ru",
      "runtime_text": "После дождя или снега мокрая обувь и принесённая вода делают вход грязнее и пол у порога более скользким; мокрые следы и капли остаются отдельно, а солома, зола или тряпка могут задержать часть грязи. Выметание, просушка у тепла и частая ходьба быстро меняют картину, поэтому след показывает недавнее условие, а не тайную историю дома.",
      "search_aliases": [
        "мокрые следы",
        "сырой пол",
        "уборка"
      ]
