  "evidence": [
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:static-plant-context-wilt-nondiagnostic","source_ref":"source:static-plant-context-umn-wilt","anchor":{"section":"Signs of heat stress"},"note":"UMN says heat and wind can cause wilt even when soil moisture is adequate. Wilt therefore does not by itself establish water shortage, disease, pests, root state, irrigation need, or outcome.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:static-plant-context-hop-support-water","source_ref":"source:static-plant-context-rutgers-hops","anchor":{"section":"Training; Watering"},"note":"Rutgers describes hop bines gripping and being trained around supporting twine, and requires moisture while excluding standing water. This does not establish a particular plant, support, water amount, growth rate, cone yield, or scene.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:static-plant-context-root-loss-transplant","source_ref":"source:static-plant-context-clemson-transplant","anchor":{"section":"Root Pruning; Planting"},"note":"Clemson describes root loss as a transplant-shock risk and watering as settling disturbed soil and supporting new-root moisture. This does not establish a survival probability, suitable season, species, root loss, plant condition, or result.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:static-plant-context-mushroom-disturbance","source_ref":"source:static-plant-context-usfs-mushroom-habitat","anchor":{"section":"Know good harvesting techniques"},"note":"USFS says raking can damage mushroom habitat; cutting or gentle removal are listed as lower-disturbance methods. This makes no comparative universal claim about cutting versus picking and promises neither fruiting nor yield.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:static-plant-context-frost-stage","source_ref":"source:static-plant-context-iastate-frost","anchor":{"section":"Frost damage"},"note":"Iowa State documents that frost effect in corn and soybean depends on temperature duration, exposed tissue and growing-point position. It establishes no premise for flax or another species, nor a threshold, death rule, yield prediction, or recovery guarantee.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:static-plant-context-cool-respiration","source_ref":"source:static-plant-context-uaf-storage","anchor":{"section":"Temperature"},"note":"UAF says stored produce remains living, and cool temperatures slow respiration and preserve quality; storage requirements vary by crop. This establishes no universal temperature, humidity, duration, maturity, or storability.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:static-plant-context-root-wounds","source_ref":"source:static-plant-context-ucanr-root-damage","anchor":{"section":"Curing Root, Tuber and Bulb Crops"},"note":"UC ANR says cuts and bruises can increase water loss, decay and physiological deterioration in harvested roots, tubers and bulbs. This establishes no actual damage, spoilage, curing success, storage state, or harvest quantity.","review_status":"approved"}
  ],
