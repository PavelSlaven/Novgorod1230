  "skills": {
    "athletics": {
      "level": "familiar",
      "display": "знаком",
      "bonus": 1,
      "basis": "Микула вырос в семье кожевника, участвовал в обычной физической работе, переноске сырья и товара, погрузке и хозяйственных поручениях. Он физически дееспособен, но не проходил военной или специальной атлетической подготовки."
    },
    "stealth": {
      "level": "no_experience",
      "display": "нет опыта",
      "bonus": 0,
      "absence_basis": "В биографии Микулы нет занятий, связанных со скрытым проникновением, слежкой, разведкой, охотой, преступным промыслом или военной скрытностью."
    },
    "melee": {
      "level": "no_experience",
      "display": "нет опыта",
      "bonus": 0,
      "absence_basis": "Микула не проходил военной службы, дружинной подготовки или систематического обучения бою с оружием. Возможность защищаться подручным предметом не является основанием для навыка ближнего боя."
    },
    "ranged_combat": {
      "level": "no_experience",
      "display": "нет опыта",
      "bonus": 0,
      "absence_basis": "Микула не служил воином, не был профессиональным охотником и не обучался регулярному применению лука, метательного оружия или других средств дальнего боя."
    },
    "craft": {
      "level": "familiar",
      "display": "знаком",
      "bonus": 1,
      "basis": "Микула — сын разорившегося кожевника и знаком с ремеслом отца, но не утверждён как самостоятельный мастер."
    },
    "household": {
      "level": "familiar",
      "display": "знаком",
      "bonus": 1,
      "basis": "Сын кожевника выполнял хозяйственные поручения семьи и работу, связанную с товаром и сырьём."
    },
    "survival": {
      "level": "familiar",
      "display": "знаком",
      "bonus": 1,
      "basis": "Торговые поездки и хозяйственные поручения дали Микуле базовый опыт дороги: оценка погоды, устройство простого привала, поддержание огня, сохранение одежды и припасов, выбор относительно безопасного места для остановки. Он не является охотником, проводником или специалистом по длительному выживанию вне поселений."
    },
    "riding": {
      "level": "familiar",
      "display": "знаком",
      "bonus": 1,
      "basis": "Микула сопровождал старших людей в торговых поездках, знаком с обычным дорожным бытом, перемещением с обозом и базовым обращением с верховым или вьючным животным. Он не является профессиональным всадником, конюхом, воином или гонцом."
    },
    "healing": {
      "level": "no_experience",
      "display": "нет опыта",
      "bonus": 0,
      "absence_basis": "Микула не обучался у лекаря, знахаря или монастырского целителя, не занимался регулярным уходом за ранеными и не имеет подтверждённого опыта лечения травм. Обычные бытовые действия не считаются профессиональным или устойчивым навыком лечения."
    },
    "observation": {
      "level": "skilled",
      "display": "умелый",
      "bonus": 2,
      "basis": "Микула считал товар и различал владельческие знаки при поручениях старших."
    },
    "communication": {
      "level": "skilled",
      "display": "умелый",
      "bonus": 2,
      "basis": "Микула сопровождал старших на торгах и участвовал в торговом общении по поручению."
    },
    "custom_and_law": {
      "level": "skilled",
      "display": "умелый",
      "bonus": 2,
      "basis": "Микула различал владельческие знаки, переписывал простые записи и знаком с торговым обычаем поручений."
    }
  },
