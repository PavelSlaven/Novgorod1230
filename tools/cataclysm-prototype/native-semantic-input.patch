+bool item::transfer_identity_from( item &source )
+{
+    if( this == &source ) {
+        return false;
+    }
+    std::vector<std::pair<item *, item *>> identity_pairs;
+    const auto collect_pairs = [&]( const auto &self, item &destination, item &original ) -> bool {
+        if( destination.typeId() != original.typeId() ) {
+            return false;
+        }
+        identity_pairs.emplace_back( &destination, &original );
+        const std::vector<item_pocket *> destination_pockets =
+            destination.contents.get_pockets( []( const item_pocket & ) { return true; } );
+        const std::vector<item_pocket *> original_pockets =
+            original.contents.get_pockets( []( const item_pocket & ) { return true; } );
+        if( destination_pockets.size() != original_pockets.size() ) {
+            return false;
+        }
+        for( size_t i = 0; i < destination_pockets.size(); ++i ) {
+            item_pocket &destination_pocket = *destination_pockets[i];
+            item_pocket &original_pocket = *original_pockets[i];
+            if( destination_pocket.saved_type() != original_pocket.saved_type() ) {
+                return false;
+            }
+            std::list<item *> destination_items = destination_pocket.all_items_top();
+            std::list<item *> original_items = original_pocket.all_items_top();
+            if( destination_items.size() != original_items.size() ) {
+                return false;
+            }
+            auto destination_item = destination_items.begin();
+            auto original_item = original_items.begin();
+            for( ; destination_item != destination_items.end(); ++destination_item, ++original_item ) {
+                if( !self( self, **destination_item, **original_item ) ) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    };
+    if( !collect_pairs( collect_pairs, *this, source ) ) {
+        return false;
+    }
+    for( const auto &[destination, original] : identity_pairs ) {
+        destination->uid_ = std::move( original->uid_ );
+    }
+    return true;
+}
