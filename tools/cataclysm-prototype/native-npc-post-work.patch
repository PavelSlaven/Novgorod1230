+bool npc::can_work_at_guard_post() const
+{
+    if( !guard_pos || !fac_id.is_valid() || !is_on_shift() || !has_job() ) {
+        return false;
+    }
+
+    const zone_manager &manager = zone_manager::get_manager();
+    for( const zone_manager::ref_const_zone_data &zone_ref : manager.get_zones( fac_id ) ) {
+        const zone_data &zone = zone_ref.get();
+        if( zone.get_enabled() && !zone.get_temporarily_disabled() &&
+            zone.has_inside( *guard_pos ) ) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool npc::has_guard_job_context() const
+{
+    if( !guard_pos ) {
+        return false;
+    }
+    return is_guarding() || mission == NPC_MISSION_CAMP_RESIDENT ||
+           ( mission == NPC_MISSION_ACTIVITY &&
+             ( previous_mission == NPC_MISSION_GUARD ||
+               previous_mission == NPC_MISSION_GUARD_ALLY ||
+               previous_mission == NPC_MISSION_GUARD_PATROL ||
+               previous_mission == NPC_MISSION_CAMP_RESIDENT ) );
+}
+
+bool npc::has_guard_job_activity() const
+{
+    if( !has_guard_job_context() || !activity ) {
+        return false;
+    }
+    if( job.get_priority_of_job( activity.id() ) > 0 ) {
+        return true;
+    }
+    return activity.auto_resume && !backlog.empty() &&
+           job.get_priority_of_job( backlog.front().id() ) > 0;
+}
+
+bool npc::has_guard_job_backlog() const
+{
+    if( !has_guard_job_context() || backlog.empty() || !backlog.front().auto_resume ) {
+        return false;
+    }
+    if( job.get_priority_of_job( backlog.front().id() ) > 0 ) {
+        return true;
+    }
+    const auto parent = std::next( backlog.begin() );
+    return parent != backlog.end() && job.get_priority_of_job( parent->id() ) > 0;
+}
+
+void npc::suspend_guard_job_activity()
+{
+    if( !has_guard_job_activity() ) {
+        return;
+    }
+    activity.auto_resume = true;
+    assign_activity( player_activity{} );
+    attitude = previous_attitude;
+    mission = previous_mission;
+    current_activity_id = activity_id::NULL_ID();
 }

