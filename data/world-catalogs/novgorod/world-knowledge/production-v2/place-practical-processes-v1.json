  "evidence": [
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:practical-cooper-hoop-compression",
      "source_ref": "source:place-practical-usdol-cooper",
      "anchor": {"section": "COOPER (wood. container), 764.684-022"},
      "note": "The modern occupational description says a cooper compresses staves to loosen hoops, then replaces and tightens hoops; it also distinguishes caulking leaking stave joints. The claim is a bounded qualitative transfer to staved-vessel fit, not a repair guarantee, historical tool list, or claim that every loosened hoop causes leakage.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:practical-water-settling-filtration",
      "source_ref": "source:place-practical-epa-water",
      "anchor": {"section": "Coagulation, sedimentation, filtration, and disinfection"},
      "note": "EPA describes particles settling and filtration removing particles, while stating that filtration without the final disinfection step is not safe to drink. The source is a modern treatment explanation, not a medieval water practice or a household method.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:practical-cloth-filter-solids",
      "source_ref": "source:place-practical-epa-cloth-filter",
      "anchor": {"section": "Cloth Filtration"},
      "note": "EPA defines cloth filtration as water passing through a cloth medium to remove solids. It does not specify a household cloth, pore size, removal rate, or safety result.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:practical-dissolved-solids-pass-filter",
      "source_ref": "source:place-practical-epa-dissolved-solids",
      "anchor": {"section": "Dissolved and suspended solids"},
      "note": "EPA distinguishes dissolved solids as particles that pass through a filter, unlike suspended solids. This supports the stated limit, not a complete contaminant inventory or a water-safety result.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:practical-wick-capillary-feed",
      "source_ref": "source:place-practical-rutgers-candle",
      "anchor": {"section": "Candle flame and capillary action"},
      "note": "Rutgers describes liquid wax travelling upward through a wick by capillary action before vaporizing and burning. The claim makes a bounded transfer from candle to a wick-fed liquid-fuel flame; it establishes neither a fuel nor lamp design, brightness, duration, historical lamp type, or individual result.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:practical-wick-soot-limit",
      "source_ref": "source:place-practical-epa-candle-soot",
      "anchor": {"section": "Candles and soot formation"},
      "note": "EPA reports soot under imperfect candle combustion and identifies composition, wick length, and drafts as factors affecting it. The claim transfers only the conditional relation to a wick-fed flame; it does not provide a universal trimming length or predict one lamp's outcome.",
      "review_status": "approved"
    }
  ],
