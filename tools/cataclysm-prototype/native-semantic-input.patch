+void npc::set_novgorod_semantic_intent( const std::string &assignment_id,
+        const std::string &intent_payload, const tripoint_abs_ms &target )
+{
+    if( !test_mode || assignment_id.empty() || intent_payload.empty() ||
+        rl_dist( pos_abs(), target ) != 1 ) {
+        throw std::invalid_argument( "NOVGOROD_NPC_INTENT_INVALID" );
+    }
+    if( !novgorod_assignment_id.empty() && novgorod_assignment_id != assignment_id &&
+        novgorod_intent_status != "interrupted_waiting_for_semantic_decision" &&
+        novgorod_intent_status != "completed" ) {
+        throw std::runtime_error( "NOVGOROD_NPC_ASSIGNMENT_IDENTITY_MISMATCH" );
+    }
+    if( novgorod_assignment_id.empty() || novgorod_assignment_id != assignment_id ) {
+        novgorod_intent_progress = 0;
+    }
+    novgorod_assignment_id = assignment_id;
+    novgorod_intent_payload = intent_payload;
+    novgorod_intent_target = target;
+    novgorod_intent_status = "active";
+    novgorod_interrupt_cause.clear();
+}
