  "claim_localizations": [
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-macro-causal-v2-visible-sun-and-shadow-are-qualitative-directional-and-time-cues","locale":"ru","runtime_text":"Видимое Солнце и тень могут быть лишь качественными ориентирами направления и времени суток; они не дают точного компаса, часа, положения, маршрута или результата навигации.","search_aliases":[]},{"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-macro-causal-v2-visible-sun-and-shadow-are-qualitative-directional-and-time-cues","locale":"en","runtime_text":"A visible Sun and shadow can be only qualitative cues to direction and time of day; they provide no exact compass, clock, position, route, or navigation result.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-macro-causal-v2-carbon-monoxide-impairs-oxygen-delivery-and-hazard-depends-on-exposure","locale":"ru","runtime_text":"Вдыхание угарного газа нарушает доставку и использование кислорода; опасность зависит от обстоятельств воздействия, но это не устанавливает воздействие, диагноз, тяжесть или исход.","search_aliases":[]},{"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-macro-causal-v2-carbon-monoxide-impairs-oxygen-delivery-and-hazard-depends-on-exposure","locale":"en","runtime_text":"Carbon-monoxide inhalation impairs oxygen delivery and use; hazard depends on exposure circumstances, without establishing exposure, diagnosis, severity, or outcome.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-macro-causal-v2-boiling-water-controls-many-microorganisms-but-not-chemicals-or-later-recontamination","locale":"ru","runtime_text":"Кипячение воды обезвреживает многие болезнетворные микроорганизмы, но не удаляет токсичные химикаты или топливо и само по себе не предотвращает повторное загрязнение.","search_aliases":[]},{"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-macro-causal-v2-boiling-water-controls-many-microorganisms-but-not-chemicals-or-later-recontamination","locale":"en","runtime_text":"Boiling water inactivates many disease-causing microorganisms, but does not remove toxic chemicals or fuel or by itself prevent later recontamination.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-macro-causal-v2-fracture-or-dislocation-can-limit-ordinary-movement-or-use","locale":"ru","runtime_text":"Костно-суставная травма, например перелом или вывих, может ограничить обычное движение, использование конечности или опору на неё; это не устанавливает диагноз или тяжесть травмы.","search_aliases":[]},{"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-macro-causal-v2-fracture-or-dislocation-can-limit-ordinary-movement-or-use","locale":"en","runtime_text":"A musculoskeletal injury such as fracture or dislocation can limit ordinary movement, limb use, or weight bearing; this establishes neither diagnosis nor severity.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-macro-causal-v2-tooth-decay-or-injury-can-cause-pain-and-interfere-with-chewing","locale":"ru","runtime_text":"Кариес или травма зуба могут вызвать боль и мешать обычному жеванию; это не устанавливает диагноз или состояние конкретного человека.","search_aliases":[]},{"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-macro-causal-v2-tooth-decay-or-injury-can-cause-pain-and-interfere-with-chewing","locale":"en","runtime_text":"Tooth decay or injury can cause pain and may interfere with ordinary chewing; this establishes no diagnosis or individual condition.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-macro-causal-v2-toxic-exposure-can-occur-by-several-routes-and-effects-vary-with-context","locale":"ru","runtime_text":"Токсичное воздействие возможно при проглатывании, вдыхании или контакте с кожей; его последствия зависят от вещества, дозы, времени и обстоятельств, но не устанавливают воздействие или исход.","search_aliases":[]},{"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-macro-causal-v2-toxic-exposure-can-occur-by-several-routes-and-effects-vary-with-context","locale":"en","runtime_text":"Toxic exposure can occur by ingestion, inhalation, or skin contact; effects vary with substance, dose, time, and context, without establishing exposure or outcome.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-macro-causal-v2-parasites-can-have-variable-symptoms-or-functional-burden","locale":"ru","runtime_text":"Паразиты могут давать разные симптомы или функциональную нагрузку, но это не устанавливает наличие паразита, путь заражения или нагрузку у конкретного человека.","search_aliases":[]},{"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-macro-causal-v2-parasites-can-have-variable-symptoms-or-functional-burden","locale":"en","runtime_text":"Parasites can produce variable symptoms or functional burden, but this establishes no parasite presence, route, or burden for an individual.","search_aliases":[]}
  ]
