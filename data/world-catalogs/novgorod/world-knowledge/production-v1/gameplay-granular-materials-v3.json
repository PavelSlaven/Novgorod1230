      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:granular-v3-capillary-bridges",
      "source_ref": "source:scheel-2008-liquid-distribution-wet-granular",
      "anchor": {"section": "Abstract"},
      "note": "Experiments on water-mixed bead packings attribute capillary cohesion to liquid–air interfaces spanning grains; behaviour varies with liquid content and high pore filling weakens it. It does not establish a scene material, saturation, grain size, hand force, mouldability, water release, or a rolled result.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:granular-v3-compression-phase-evolution",
      "source_ref": "source:milatz-2021-partially-saturated-granular-compression",
      "anchor": {"section": "Abstract; §1.1–1.1.2"},
      "note": "In-situ uniaxial-compression experiments on Hamburg Sand and glass beads measured air–water interfaces, water clusters and local strain fields through deformation. The paper treats their evolution as dependent on saturation and grain-scale structure; it does not establish outward drainage, a connected path, amount/rate of water movement, or a particular action result.",
      "review_status": "approved"
    }
