  "claim_localizations": [
    { "schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:static-forge-welding-requires-heated-pressed-interface", "locale": "ru", "runtime_text": "Кузнечная сварка требует прижатой границы, нагрева до сварочного состояния и последующего давления. Материал, режим, усилие и результат задаются конкретным процессом.", "search_aliases": [] },
    { "schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:static-forge-welding-requires-heated-pressed-interface", "locale": "en", "runtime_text": "Forge welding requires a seated interface, heating to welding condition, and subsequent pressure. Material, conditions, force and result belong to the concrete process.", "search_aliases": [] },
    { "schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:static-forge-welding-surface-oxide-can-degrade-join", "locale": "ru", "runtime_text": "Поверхностный оксид может ухудшить кузнечный шов. Это не устанавливает оксид, флюс или результат конкретного соединения.", "search_aliases": [] },
    { "schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:static-forge-welding-surface-oxide-can-degrade-join", "locale": "en", "runtime_text": "Surface oxide can degrade a forge-weld join. This establishes no oxide, flux or result for a concrete joint.", "search_aliases": [] },
