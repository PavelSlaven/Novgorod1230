  "claim_localizations": [
    { "schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:r401-wood-drying-can-loosen-wheel-fit", "locale": "ru", "runtime_text": "INFERENCE: При высыхании деревянной детали поперечное изменение размера может ослабить прежде плотную посадку обода или шины на колесе.", "search_aliases": [] },
    { "schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:r401-wood-drying-can-loosen-wheel-fit", "locale": "en", "runtime_text": "INFERENCE: As a wooden wheel part dries, cross-grain dimensional change can reduce a formerly tight rim or tire fit.", "search_aliases": [] },
    { "schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:r401-wheel-condition-needs-cause-distinction", "locale": "ru", "runtime_text": "INFERENCE: Движение обода или шины, зазор либо раскрывшиеся стыки — повод осмотреть колесо; по этим признакам нельзя однозначно отличить усушку от износа, повреждения дерева или ослабленных соединений.", "search_aliases": [] },
    { "schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:r401-wheel-condition-needs-cause-distinction", "locale": "en", "runtime_text": "INFERENCE: Rim or tire movement, a gap, or opened joints warrants inspection, but those signs do not uniquely distinguish shrinkage from wear, wood damage, or loosened joints.", "search_aliases": [] },
    { "schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:r401-established-woody-plant-water-reaches-root-zone", "locale": "ru", "runtime_text": "INFERENCE: У уже укоренившегося древесного растения с доступной почвой вокруг вода, направленная в корневую зону, может достигать корней лучше, чем повторное смачивание одной поверхности.", "search_aliases": [] },
    { "schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:r401-established-woody-plant-water-reaches-root-zone", "locale": "en", "runtime_text": "INFERENCE: For an established woody plant with usable surrounding soil, water directed into the accessible root zone can reach roots more effectively than repeated surface-only wetting.", "search_aliases": [] },
    { "schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:r401-root-water-and-oxygen-limits", "locale": "ru", "runtime_text": "INFERENCE: Частое лёгкое смачивание, пересушка и длительное насыщение почвы водой — разные условия корневой зоны, потому что корням нужны и вода, и кислород.", "search_aliases": [] },
    { "schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:r401-root-water-and-oxygen-limits", "locale": "en", "runtime_text": "INFERENCE: Repeated light wetting, drought, and prolonged soil saturation are distinct root-zone conditions because roots require both water and oxygen.", "search_aliases": [] },
    { "schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:r401-churning-coalesces-fat-and-releases-buttermilk", "locale": "ru", "runtime_text": "INFERENCE: При сбивании сливок жировые шарики могут слипаться в зёрна или комки масла, а пахта отделяется и может быть слита.", "search_aliases": [] },
    { "schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:r401-churning-coalesces-fat-and-releases-buttermilk", "locale": "en", "runtime_text": "INFERENCE: Churning cream can coalesce fat globules into butter grains or clumps while buttermilk separates and can be drained.", "search_aliases": [] },
    { "schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:r401-cream-condition-and-working-affect-churning", "locale": "ru", "runtime_text": "INFERENCE: Температура сливок и объём работы могут влиять на образование масляных зёрен и характер результата, но не доказывают порог, выход или успех.", "search_aliases": [] },
    { "schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:r401-cream-condition-and-working-affect-churning", "locale": "en", "runtime_text": "INFERENCE: Cream temperature and the amount of working can materially affect butter-grain formation and result character, without establishing a threshold, yield, or success.", "search_aliases": [] },
    { "schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:r401-cracked-shell-compromises-egg-barrier", "locale": "ru", "runtime_text": "INFERENCE: Видимая трещина нарушает целостность защитной скорлупы яйца и не является лишь косметическим дефектом.", "search_aliases": [] },
    { "schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:r401-cracked-shell-compromises-egg-barrier", "locale": "en", "runtime_text": "INFERENCE: A visible crack compromises the intact shell barrier of an egg and is more than a cosmetic condition.", "search_aliases": [] },
    { "schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:r401-warm-cracked-egg-needs-cautious-condition-reading", "locale": "ru", "runtime_text": "INFERENCE: Тёплое, треснувшее или сильно тронутое яйцо требует более осторожной оценки состояния, чем чистое целое холодно хранившееся яйцо, но это не доказывает загрязнение, порчу или безопасность.", "search_aliases": [] },
    { "schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:r401-warm-cracked-egg-needs-cautious-condition-reading", "locale": "en", "runtime_text": "INFERENCE: A warm, cracked, or heavily handled egg calls for more cautious condition reading than a clean intact cold-stored egg, but those observations do not establish contamination, spoilage, or safety.", "search_aliases": [] }
  ]
