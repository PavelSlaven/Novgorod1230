  "evidence": [
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:candidate-macro-causal-v2-solar-position","source_ref":"source:candidate-macro-causal-v2-noaa-solar-position","anchor":{"section":"Solar Position Calculator; Solar Azimuth and Solar Elevation"},"note":"NOAA's calculator derives solar azimuth and elevation from supplied location and time. It supports only the inferred qualitative cue; it does not validate a compass reading, exact time, location, route, or result.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:candidate-macro-causal-v2-co-oxygen","source_ref":"source:candidate-macro-causal-v2-cdc-co-guidance","anchor":{"section":"How to Recognize CO Poisoning"},"note":"CDC states CO effects result from impaired oxygen delivery and disrupted oxygen use/respiration at the cellular level. It does not establish exposure, diagnosis, severity, or outcome for an actor.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:candidate-macro-causal-v2-water-boiling","source_ref":"source:candidate-macro-causal-v2-epa-water-disinfection","anchor":{"section":"Boil water"},"note":"EPA says boiling kills pathogenic bacteria, viruses and protozoa, while boiling or disinfection does not destroy heavy metals, salts, and most chemicals.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:candidate-macro-causal-v2-water-storage","source_ref":"source:candidate-macro-causal-v2-epa-water-disinfection","anchor":{"section":"Boil water; store it in clean containers with covers"},"note":"EPA's clean covered-storage instruction supports the bounded inference that boiling alone does not prevent later recontamination; it establishes no water condition.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:candidate-macro-causal-v2-fracture-mobility","source_ref":"source:candidate-macro-causal-v2-medlineplus-broken-bone","anchor":{"section":"Symptoms"},"note":"MedlinePlus lists limited mobility or inability to move a limb or put weight on a leg among possible broken-bone symptoms. It does not diagnose an injury.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:candidate-macro-causal-v2-dislocation-mobility","source_ref":"source:candidate-macro-causal-v2-medlineplus-dislocation","anchor":{"section":"Symptoms"},"note":"MedlinePlus describes a dislocated joint as potentially very painful on use or weight bearing and limited in movement. It does not diagnose an injury.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:candidate-macro-causal-v2-tooth-pain","source_ref":"source:candidate-macro-causal-v2-nidcr-tooth-decay","anchor":{"section":"Symptoms"},"note":"NIDCR says advancing tooth decay can cause toothache or sensitivity. Any interference with chewing is a bounded functional inference, not a diagnosis.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:candidate-macro-causal-v2-tooth-injury","source_ref":"source:candidate-macro-causal-v2-nhs-toothache","anchor":{"section":"Causes of toothache"},"note":"NHS lists a cracked or damaged tooth among toothache causes. It establishes neither a particular injury nor diagnosis for an actor.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:candidate-macro-causal-v2-toxic-pathways","source_ref":"source:candidate-macro-causal-v2-atsdr-exposure-pathways","anchor":{"section":"What does Exposed Mean?; Exposure route"},"note":"ATSDR identifies dermal contact, inhalation, and ingestion as exposure routes and explains that possible illness depends on contaminant properties, concentration, duration or frequency, route, and individual context. The record establishes no specific substance, dose, exposure, or outcome.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:candidate-macro-causal-v2-parasite-burden","source_ref":"source:candidate-macro-causal-v2-cdc-parasites","anchor":{"section":"Protozoa; Helminths; Ectoparasites; Parasitic Infections"},"note":"CDC distinguishes parasite classes and routes and describes substantial but varying disease burden, including lost ability to attend school or work. It does not establish a parasite, route, or burden for an actor.","review_status":"approved"}
  ],
