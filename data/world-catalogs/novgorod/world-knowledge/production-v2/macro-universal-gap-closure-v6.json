  "claim_localizations": [
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v6-dehydration-is-fluid-loss-exceeding-intake","locale":"ru","runtime_text":"Обезвоживание возникает, когда потеря жидкости превышает её поступление; это не устанавливает баланс жидкости конкретного человека.","search_aliases":[]},{"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v6-dehydration-is-fluid-loss-exceeding-intake","locale":"en","runtime_text":"Dehydration occurs when fluid loss exceeds intake; this establishes no individual's fluid balance.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v6-dehydration-can-have-nonspecific-observations","locale":"ru","runtime_text":"Жажда, сухость во рту, редкое мочеиспускание, усталость и головокружение могут сопутствовать обезвоживанию, но не устанавливают его причину или диагноз конкретного человека.","search_aliases":[]},{"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v6-dehydration-can-have-nonspecific-observations","locale":"en","runtime_text":"Thirst, dry mouth, reduced urination, tiredness and dizziness can accompany dehydration, but establish neither cause nor diagnosis for an individual.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v6-clinical-assessment-can-combine-observations-and-tests","locale":"ru","runtime_text":"Клиническая оценка обезвоживания может сочетать осмотр, жизненные показатели, историю симптомов и при наличии тесты; это не является диагнозом из одной игровой реплики.","search_aliases":[]},{"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v6-clinical-assessment-can-combine-observations-and-tests","locale":"en","runtime_text":"Clinical dehydration assessment can combine examination, vital signs, symptom history and, when available, tests; it is not a diagnosis from one game utterance.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v6-burn-is-tissue-damage-from-several-energy-or-chemical-causes","locale":"ru","runtime_text":"Ожог — повреждение тканей, которое могут вызвать тепло, химикаты, электричество, солнечный свет или излучение; это не устанавливает конкретное повреждение.","search_aliases":[]},{"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v6-burn-is-tissue-damage-from-several-energy-or-chemical-causes","locale":"en","runtime_text":"A burn is tissue damage that can be caused by heat, chemicals, electricity, sunlight or radiation; this establishes no particular injury.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v6-burned-skin-barrier-can-increase-infection-risk","locale":"ru","runtime_text":"Повреждение ожогом защитного барьера кожи может повысить риск инфекции; это не устанавливает инфекцию или её исход.","search_aliases":[]},{"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v6-burned-skin-barrier-can-increase-infection-risk","locale":"en","runtime_text":"Burn damage to the skin barrier can increase infection risk; this establishes no infection or outcome.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v6-burn-consequences-depend-on-cause-depth-and-area","locale":"ru","runtime_text":"Последствия ожога и потребности в уходе зависят от причины, глубины и затронутой площади; это не устанавливает тяжесть или исход конкретного ожога.","search_aliases":[]},{"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v6-burn-consequences-depend-on-cause-depth-and-area","locale":"en","runtime_text":"Burn consequences and care needs depend on cause, depth and affected area; this establishes no particular severity or outcome.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v6-foodborne-illness-can-have-nonspecific-gastrointestinal-or-fever-observations","locale":"ru","runtime_text":"При пищевой болезни возможны расстройство желудка, спазмы, тошнота, рвота, диарея или лихорадка; эти признаки не определяют конкретный возбудитель или диагноз.","search_aliases":[]},{"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v6-foodborne-illness-can-have-nonspecific-gastrointestinal-or-fever-observations","locale":"en","runtime_text":"Foodborne illness can involve upset stomach, cramps, nausea, vomiting, diarrhea or fever; these signs do not identify a specific germ or diagnosis.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v6-moon-phases-change-apparent-illuminated-portion","locale":"ru","runtime_text":"Фазы Луны меняют видимую освещённую часть Луны, но не устанавливают дату, положение, погоду или освещённость местности.","search_aliases":[]},{"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v6-moon-phases-change-apparent-illuminated-portion","locale":"en","runtime_text":"Lunar phases change the apparent illuminated portion of the Moon, but establish no date, position, weather or ground illumination.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v6-raw-animal-foods-should-be-separated-to-limit-cross-contamination","locale":"ru","runtime_text":"Разделение сырого мяса, птицы, морепродуктов и яиц с другой пищей ограничивает риск перекрёстного загрязнения; это не устанавливает факт загрязнения.","search_aliases":[]},{"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v6-raw-animal-foods-should-be-separated-to-limit-cross-contamination","locale":"en","runtime_text":"Separating raw meat, poultry, seafood or eggs from other food limits cross-contamination risk; this establishes no contamination event.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v6-clean-hands-and-surfaces-are-a-food-handling-control","locale":"ru","runtime_text":"Очистка рук и поверхностей контакта с пищей — мера безопасного обращения; это не устанавливает их текущую чистоту или микробиологическое состояние.","search_aliases":[]},{"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v6-clean-hands-and-surfaces-are-a-food-handling-control","locale":"en","runtime_text":"Cleaning hands and food-contact surfaces is a food-handling control; this establishes no current cleanliness or microbiological state.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v6-raw-meat-and-catfish-are-food-safety-handling-contexts","locale":"ru","runtime_text":"Сырое мясо и сом — контексты обращения с пищей, где важна пищевая безопасность; это не устанавливает загрязнение или болезнь.","search_aliases":[]},{"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v6-raw-meat-and-catfish-are-food-safety-handling-contexts","locale":"en","runtime_text":"Raw meat and catfish are food-safety handling contexts; this establishes no contamination or illness.","search_aliases":[]}
  ]
