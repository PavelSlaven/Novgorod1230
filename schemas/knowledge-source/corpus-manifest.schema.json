{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rus.knowledge_corpus_manifest.v2",
  "type": "object",
  "required": ["schema_version", "corpus_id", "documents"],
  "properties": {
    "schema_version": { "const": "rus.knowledge_corpus_manifest.v2" },
    "corpus_id": { "type": "string", "minLength": 1 },
    "release": { "type": "string" },
    "source_release": { "type": "string" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["document_id", "canonical_path", "file_name", "sha256", "bytes", "status"],
        "properties": {
          "document_id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
          "canonical_path": { "type": "string", "pattern": "^corpus/DOCUMENTS/[^/]+$" },
          "file_name": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "status": { "enum": ["proposed", "active", "deprecated"] },
          "provenance_mode": { "enum": ["native", "legacy_mirror", "canonicalized_from_legacy"] },
          "source_legacy_path": { "type": "string", "minLength": 1 },
          "source_legacy_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "source_legacy_bytes": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
