  "claim_localizations": [
    {
      "schema": "world_knowledge_claim_localization_v1",
      "claim_ref": "claim:research-memory-source-misattribution",
      "locale": "ru",
      "runtime_text": "При воспоминании человек может путать источник информации. Это не устанавливает, что actor видел, помнит или считает истинным, правдивость показаний либо намеренный обман.",
      "search_aliases": []
    },
    {
      "schema": "world_knowledge_claim_localization_v1",
      "claim_ref": "claim:research-memory-source-misattribution",
      "locale": "en",
      "runtime_text": "Recollection can confuse the source of information. This does not establish what an actor witnessed, remembers, believes, or whether testimony is true or deliberately deceptive.",
      "search_aliases": []
    },
    {
      "schema": "world_knowledge_claim_localization_v1",
      "claim_ref": "claim:research-memory-postevent-misinformation",
      "locale": "ru",
      "runtime_text": "Вводящая в заблуждение информация после события может искажать последующее воспоминание о нём. Это не устанавливает получение информации, изменение памяти, знания actor, вероятность ошибки, оценку показаний или возможность внедрить конкретное воспоминание.",
      "search_aliases": []
    },
    {
      "schema": "world_knowledge_claim_localization_v1",
      "claim_ref": "claim:research-memory-postevent-misinformation",
      "locale": "en",
      "runtime_text": "Misleading information received after an event can distort later recollection of it. This establishes no exposure, changed memory, actor knowledge, error probability, testimony verdict, or ability to implant a particular memory.",
      "search_aliases": []
    },
    {
      "schema": "world_knowledge_claim_localization_v1",
      "claim_ref": "claim:research-pooled-work-social-loafing",
      "locale": "ru",
      "runtime_text": "Объединение вкладов без индивидуальной оценки может снижать личную отдачу в работе; это не неизбежный эффект. Это не задаёт распространённость в Средневековье, мотив работника, необходимый штат, темп труда, распределение работ, подчинение или решение NPC.",
      "search_aliases": []
    },
    {
      "schema": "world_knowledge_claim_localization_v1",
      "claim_ref": "claim:research-pooled-work-social-loafing",
      "locale": "en",
      "runtime_text": "Pooling contributions without individual evaluation can reduce individual work output; this is conditional, not inevitable. This provides no medieval prevalence, worker motive, staffing requirement, labour rate, allocation, compliance, or forced NPC decision.",
