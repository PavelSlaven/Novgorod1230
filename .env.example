# Variables set by the user.
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_REQUEST_TIMEOUT_MS=120000
RUS_SERVER_PORT=3000
PORTRAIT_SPEC_NORMALIZER_MODEL=deepseek-v4-flash

# Variables computed by `npm run play:local`; do not set them manually.
# RUS_RUNTIME_ROUTE=modular
# RUS_CUTOVER_STAGE=13
# RUS_COMPOSITION_MODULE=builtin:production-spatial-v3
# RUS_SPATIAL_V3_BINDINGS_MODULE=builtin:spatial-v3-production-v15
# RUS_WORLD_KNOWLEDGE_PYTHON=python
# RUS_SPATIAL_V3_RUNTIME_CATALOG_PIN_MANIFEST_DIGEST=<loaded from local world DB>
# RUS_WORLD_DATABASE_URL=<local world DB>
# RUS_PARTY_DATABASE_URL=<local party DB>
# RUS_DATABASE_SSL=false
# RUS_SERVER_HOST=127.0.0.1
# RUS_TURN_DECISION_SECRET=<local launcher value>

# Canonical documentation corpus and generated representations.
RUS_KNOWLEDGE_SOURCE_ROOT=./data/knowledge-source
RUS_GENERATED_KNOWLEDGE_ROOT=./generated/knowledge-source
