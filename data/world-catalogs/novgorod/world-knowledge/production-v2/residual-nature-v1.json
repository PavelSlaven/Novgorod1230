      "evidence_ref": "evidence:residual-nature-snow-grain-compaction",
      "source_ref": "source:residual-nature-nsidc-snow",
      "anchor": {
        "section": "Snow on the ground; Snow and sound"
      },
      "note": "Snow grains change after deposition, later snowfalls compress them, and stepping on snow also compresses grains.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:residual-nature-snow-melt-refreeze-crust",
      "source_ref": "source:residual-nature-nsidc-snow",
      "anchor": {
        "section": "Snow and sound; Types of snow"
      },
      "note": "The source describes a melted/refrozen snow surface as hard and smooth and snowpack crusted layers caused by melting and refreezing.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:residual-nature-snow-wind-drift-visibility",
      "source_ref": "source:residual-nature-nsidc-snow",
      "anchor": {
        "section": "Types of snowfall; Blizzards"
      },
      "note": "Strong winds can lift already fallen snow, reduce visibility and create drifts that obstruct travel.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:residual-nature-snow-depth-not-load",
      "source_ref": "source:residual-nature-pnnl-snow-loads",
      "anchor": {
        "section": "Snow Types and Conditions"
      },
      "note": "Wet snow can weigh much more than dry snow at equal depth; rain retained in snow and additional snowfalls increase load. No design capacities or modern code requirements are imported.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:residual-nature-snow-uneven-roof-loading",
      "source_ref": "source:residual-nature-pnnl-snow-loads",
      "anchor": {
        "section": "Description; Building Topology and Shape"
      },
      "note": "Wind and roof geometry create uneven accumulation; excessive snow can deflect structural members or cause failure.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:residual-nature-roof-melt-eave-refreezing",
      "source_ref": "source:residual-nature-pnnl-snow-loads",
      "anchor": {
        "section": "Roof Insulation Quality"
      },
      "note": "Heat escaping from the interior can melt roof snow even when outside air is below freezing; runoff can refreeze at colder eaves, impede drainage and back water under covering.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:residual-nature-ice-current-thin-areas",
      "source_ref": "source:residual-nature-nps-ice",
      "anchor": {
        "section": "Winter Beach Safety"
      },
      "note": "NPS explicitly states that subsurface flows can create unseen thin areas in ponds, creeks and other waterways. Universal causal relation only; no Indiana-specific condition is projected onto Novgorod.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:residual-nature-snow-conceals-ice-gaps",
      "source_ref": "source:residual-nature-nps-ice",
      "anchor": {
        "section": "Winter Beach Safety; Shelf Ice"
      },
      "note": "NPS describes hidden thin spots and gaps in lake/shelf ice, often further hidden by snow. Claim stays conditional on ice with such gaps, without importing local occurrence.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:residual-nature-twilight-solar-afterglow",
      "source_ref": "source:residual-nature-rmg-twilight",
      "anchor": {
        "section": "What is twilight?"
      },
      "note": "Civil twilight permits bright-star/horizon visibility; astronomical twilight ends the Sun's afterglow. Extract qualitative lighting transition, not fixed clock times or a guarantee under clouds.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:residual-nature-stars-horizon-navigation",
      "source_ref": "source:residual-nature-rmg-twilight",
      "anchor": {
        "section": "Nautical twilight"
      },
      "note": "Source explicitly explains navigation by known stars relative to a still discernible horizon. No medieval adoption or actual observer skill is asserted.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:residual-nature-celestial-pole-daily-circles",
      "source_ref": "source:residual-nature-nasa-north",
      "anchor": {
        "section": "Opening explanation of Earth's rotational axis and apparent star circles"
      },
      "note": "Stars appear to circle the celestial pole as Earth rotates; the northern pole is the direction of Earth's north rotational axis. Do not assert modern Polaris angular alignment in 1230.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:residual-nature-pole-star-precession-limit",
