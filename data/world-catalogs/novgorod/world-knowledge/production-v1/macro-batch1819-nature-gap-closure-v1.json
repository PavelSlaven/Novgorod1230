  "claim_localizations": [
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:macro-b1819-ill-cattle-observation-is-nondiagnostic-and-can-warrant-experienced-assessment","locale":"ru","runtime_text":"Снижение еды или питья, необычная поза либо движение, дыхание или выделения, изменение навоза и отставание от группы у КРС могут быть поводом для внимательного наблюдения и доступной опытной помощи по животным. Один признак не устанавливает причину или лечение.","search_aliases":["корова не ест и отстаёт","КРС странно дышит","что наблюдать у больной коровы"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:macro-b1819-ill-cattle-observation-is-nondiagnostic-and-can-warrant-experienced-assessment","locale":"en","runtime_text":"Reduced eating or drinking, unusual posture or movement, breathing or discharge changes, altered manure, or lagging in cattle can warrant careful observation and available experienced animal-care assessment. No single sign identifies a cause or treatment.","search_aliases":["cow not eating and lagging","cattle breathing oddly","observe sick cattle"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:macro-b1819-cow-calf-separation-is-a-stressful-transition-and-context-can-moderate-added-stress","locale":"ru","runtime_text":"Разделение коровы и телёнка — стрессовый переход; знакомое окружение с известными едой или водой и отсутствие лишнего беспокойства могут уменьшать добавочный стресс. Это не задаёт план обращения или исход.","search_aliases":["отъём телёнка стресс","разлучить корову телёнка","телёнок после отъёма"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:macro-b1819-cow-calf-separation-is-a-stressful-transition-and-context-can-moderate-added-stress","locale":"en","runtime_text":"Cow-calf separation is a stressful transition; familiar surroundings with known food or water and avoidance of extra disturbance can reduce added stress. This supplies no handling plan or outcome.","search_aliases":["calf weaning stress","separate cow calf","calf after weaning"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:macro-b1819-wet-cold-wind-can-overwhelm-sheep-insulation-and-dry-shelter-reduces-exposure","locale":"ru","runtime_text":"Холод, сырость и ветер могут ухудшать теплоизоляцию шерсти овцы и усиливать потерю тепла; сухое укрытие, защита от ветра и более сухая подстилка либо грунт уменьшают это воздействие. Это не описывает конкретную погоду, животное или исход.","search_aliases":["мокрая овца на ветру","овцы холод дождь","сухое укрытие овец"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:macro-b1819-wet-cold-wind-can-overwhelm-sheep-insulation-and-dry-shelter-reduces-exposure","locale":"en","runtime_text":"Cold, wet, or windy conditions can reduce sheep coat insulation and increase heat loss; dry shelter, wind protection, and drier footing or bedding reduce that exposure. This describes no particular weather, animal, or outcome.","search_aliases":["wet sheep in wind","sheep cold rain","dry sheep shelter"]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:macro-b1819-smoke-or-ash-can-irritate-eyes-and-supports-clean-air-and-rinsing-response","locale":"ru","runtime_text":"Дым или зола могут раздражать глаза; качественный немедленный ответ — уменьшить воздействие и смыть золу либо частицы доступной чистой водой, не объявляя травму глаза и не обещая выздоровления.","search_aliases":["дым в глазах","зола в глазах","промыть глаза от дыма"]},
