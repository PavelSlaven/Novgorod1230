  "evidence": [
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:place-thermal-birch-tar-methods",
      "source_ref": "source:place-thermal-birch-tar-schmidt-2023",
      "anchor": {"section": "Abstract and experimental production methods"},
      "note": "The study documents an intentionally created low-oxygen underground tar-distillation environment and contrasts it with simpler methods. Editorial composition: heating bark releases material that can be condensed or collected along a distinct path; closure or covering can change air access, but establishes neither a recipe nor an outcome.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:place-thermal-ovin-structure",
      "source_ref": "source:place-thermal-ovin-ethnomuseum",
      "anchor": {"section": "Овины и риги"},
      "note": "The museum describes ovins and rigas for drying grain sheaves, with a furnace and a sheaf area on grates in separate or shared rooms. Editorial composition: warmed air or smoke can pass toward spaced sheaves; heat and air exchange can remove moisture, while direct flame or sparks remain a separate hazard for dry material. This is later Upper Volga analogy plus general physical reasoning, not medieval Novgorod attestation or a drying regime.",
      "review_status": "approved"
    }
  ],
