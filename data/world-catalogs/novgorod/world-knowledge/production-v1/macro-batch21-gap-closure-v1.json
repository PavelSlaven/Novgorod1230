  "evidence": [
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:macro-b21-rain-soil-crust","source_ref":"source:macro-b21-nrcs-soil-crusts","anchor":{"section":"Soil crust effects"},"note":"NRCS identifies a surface crust as indicating poor infiltration and a problematical seedbed, and says crusts restrict seedling emergence. This establishes neither a crust, rain, crop, field condition, remediation, nor result in a scene.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:macro-b21-willow-cutting-establishment","source_ref":"source:macro-b21-nrcs-willow-establishment","anchor":{"section":"Willow cuttings; establishment conditions"},"note":"NRCS describes establishment of willow from cuttings and ties successful planting to suitable site moisture, season/dormancy and correct planting. This establishes no species, cutting, place, water-table depth, rooting time, survival or local planting practice.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:macro-b21-frost-heave","source_ref":"source:macro-b21-hud-frost-protected-foundations","anchor":{"section":"Frost heave protection"},"note":"HUD's guide explains that frost-protected foundation design prevents frost-heave damage by keeping susceptible ground from freezing. This establishes no frost, soil, post, building, movement magnitude, damage or repair in a scene.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:macro-b21-charcoal-forge-fuel","source_ref":"source:macro-b21-fao-blacksmith-fire","anchor":{"section":"Fuel"},"note":"FAO identifies charcoal as forge fuel and explains that heat is produced by burning fuel with air. Combined with the ordinary physical need to heat retained water before it can leave fuel, this supports a qualitative operational limit for wet charcoal, not a fuel stock, forge, drying method, temperature or working outcome.","review_status":"approved"},
    {"schema":"world_knowledge_evidence_v1","evidence_ref":"evidence:macro-b21-saw-kerf-compression","source_ref":"source:macro-b21-usfs-saws-that-sing","anchor":{"section":"Preventing slabbing and kerf compression"},"note":"USFS describes compression closing a saw kerf and the use of continued control and wedges to keep it open. This establishes no particular saw, board, log, grain, support, worker skill, injury, cut completion or repair result.","review_status":"approved"}
  ],
