  "claim_localizations": [
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v3-child-development-has-recognizable-periods","locale":"ru","runtime_text":"Развитие ребёнка можно описывать через младенчество, дошкольный возраст, среднее детство и подростковый возраст; это не устанавливает возраст или развитие конкретного ребёнка.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v3-child-development-has-recognizable-periods","locale":"en","runtime_text":"Child development can be described across infancy, preschool, middle childhood and adolescence; this establishes no particular child's age or development.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v3-puberty-can-coincide-with-final-growth-spurt","locale":"ru","runtime_text":"В начале пубертата начинается заключительный скачок роста; это не устанавливает возраст, срок или развитие конкретного человека.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v3-puberty-can-coincide-with-final-growth-spurt","locale":"en","runtime_text":"A final growth spurt begins at the start of puberty; this establishes no individual's age, timing or development.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v3-aging-changes-cell-function","locale":"ru","runtime_text":"Старение изменяет клетки и может уменьшать их функциональную способность; это не устанавливает возраст, нарушение или состояние конкретного человека.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v3-aging-changes-cell-function","locale":"en","runtime_text":"Aging changes cells and can reduce their functional capacity; this establishes no individual's age, impairment or condition.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v3-aging-organs-gradually-lose-function","locale":"ru","runtime_text":"При старении органы постепенно теряют функцию, причём изменения различаются между людьми и органами; это не устанавливает способность или исход конкретного человека.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v3-aging-organs-gradually-lose-function","locale":"en","runtime_text":"Aging organs gradually lose function, with variation between people and organs; this establishes no individual's capacity or outcome.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v3-force-beyond-bone-capacity-can-fracture-it","locale":"ru","runtime_text":"Сила, превышающая способность кости выдержать её, может расколоть или сломать кость; это не устанавливает силу, травму или исход.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v3-force-beyond-bone-capacity-can-fracture-it","locale":"en","runtime_text":"Force beyond a bone's capacity can split or break it; this establishes no force, injury or outcome.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v3-dislocation-disrupts-normal-joint-position","locale":"ru","runtime_text":"Вывих нарушает нормальное положение костей, соединяющихся в суставе; это не устанавливает травму, часть тела, тяжесть или лечение.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v3-dislocation-disrupts-normal-joint-position","locale":"en","runtime_text":"A dislocation disrupts the normal position of bones meeting at a joint; this establishes no injury, body part, severity or treatment.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v3-poison-exposure-can-use-several-routes","locale":"ru","runtime_text":"Ядовитые вещества могут попасть в организм при проглатывании, вдыхании, инъекции или всасывании через кожу; это не устанавливает вещество, дозу, воздействие, симптом или исход.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v3-poison-exposure-can-use-several-routes","locale":"en","runtime_text":"Poisonous substances can enter the body by swallowing, inhalation, injection or skin absorption; this establishes no substance, dose, exposure, symptom or outcome.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v3-oral-bacteria-acid-can-damage-enamel","locale":"ru","runtime_text":"Бактерии во рту могут производить кислоты, атакующие зубную эмаль и запускающие кариес; это не устанавливает человека, пищу, симптом, диагноз или лечение.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v3-oral-bacteria-acid-can-damage-enamel","locale":"en","runtime_text":"Oral bacteria can make acids that attack tooth enamel and begin tooth decay; this establishes no person, food, symptom, diagnosis or treatment.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v3-disability-reflects-health-and-context-interaction","locale":"ru","runtime_text":"Инвалидность может возникать из взаимодействия состояния здоровья с факторами среды и личными факторами; это не устанавливает состояние, способность, доступ или исход конкретного человека.","search_aliases":[]},
    {"schema":"world_knowledge_claim_localization_v1","claim_ref":"claim:candidate-v3-disability-reflects-health-and-context-interaction","locale":"en","runtime_text":"Disability can result from interaction between health conditions and environmental and personal factors; this establishes no person's condition, ability, access or outcome.","search_aliases":[]}
  ]
