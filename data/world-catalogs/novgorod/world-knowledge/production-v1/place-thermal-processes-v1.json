  "claim_localizations": [
    {"schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:place-thermal-birch-tar-can-link-heated-bark-and-a-separate-collection-path", "locale": "ru", "runtime_text": "При изготовлении берёзового дёгтя нагрев бересты может выделять материал, который затем конденсируют или собирают отдельным путём. Это описывает связь этапов процесса, а не наличие бересты, готового дёгтя или заданную установку.", "search_aliases": ["берёзовый дёготь", "береста", "сбор дёгтя"]},
    {"schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:place-thermal-birch-tar-can-link-heated-bark-and-a-separate-collection-path", "locale": "en", "runtime_text": "In birch-tar making, heating bark can release material that is then condensed or collected along a separate path. This describes process relations, not available bark, finished tar, or a fixed apparatus.", "search_aliases": ["birch tar", "bark", "tar collection"]},
    {"schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:place-thermal-birch-tar-method-choice-can-change-oxygen-and-collection-conditions", "locale": "ru", "runtime_text": "Разные способы получения берёзового дёгтя по-разному ограничивают приток воздуха и собирают продукт; повреждённое покрытие или закрытие меняет эти условия, но не гарантирует исход. Из этого не следует единственная обязательная яма, сосуд, режим огня или рецепт.", "search_aliases": ["дёготь", "кислород", "перегонка"]},
    {"schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:place-thermal-birch-tar-method-choice-can-change-oxygen-and-collection-conditions", "locale": "en", "runtime_text": "Birch-tar methods can differ in oxygen access and product collection; a damaged cover or closure changes those conditions but guarantees no outcome. This implies neither one required pit, vessel, firing regime, nor recipe.", "search_aliases": ["tar method", "oxygen", "distillation"]},
    {"schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:place-thermal-ovin-can-relate-a-furnace-to-sheaves-held-on-grates", "locale": "ru", "runtime_text": "В реконструкции овина или риги печь может быть связана с местом, где снопы лежат на колосниках с промежутками: к ним проходит нагретый воздух или дым. Это аналогия устройства и функции, не доказательство конкретной постройки, топки или запаса зерна.", "search_aliases": ["овин", "рига", "снопы", "колосники"]},
    {"schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:place-thermal-ovin-can-relate-a-furnace-to-sheaves-held-on-grates", "locale": "en", "runtime_text": "In an ovin or riga reconstruction, a furnace can relate to sheaves held with gaps on grates, where warmed air or smoke can pass toward them. This is an analogy of structure and function, not proof of a particular building, fire, or grain stock.", "search_aliases": ["ovin", "riga", "sheaves", "grates"]},
    {"schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:place-thermal-ovin-heat-source-and-sheaf-area-can-have-distinct-work-roles", "locale": "ru", "runtime_text": "Нагретый воздух и воздухообмен вокруг разложенных с промежутками снопов могут уносить влагу при сушке. Прямой огонь или искры остаются отдельной опасностью для сухого материала; это не задаёт число помещений, режим воздуха, температуру или длительность.", "search_aliases": ["сушка зерна", "печь", "снопы", "воздух"]},
    {"schema": "world_knowledge_claim_localization_v1", "claim_ref": "claim:place-thermal-ovin-heat-source-and-sheaf-area-can-have-distinct-work-roles", "locale": "en", "runtime_text": "Warmed air and air exchange around spaced sheaves can carry away moisture during drying. Direct flame or sparks remain a separate hazard for dry material; this fixes no room count, air regime, temperature, or duration.", "search_aliases": ["grain drying", "furnace", "sheaves", "air"]}
