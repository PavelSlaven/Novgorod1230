  "evidence": [
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:place-feathered-mobile-young-bird-can-be-fledgling",
      "source_ref": "source:place-young-bird-guidance-wcv",
      "anchor": {"section": "Fledglings: Meant to be on the ground"},
      "note": "The Wildlife Center of Virginia describes a fully feathered young bird able to hop or flutter as likely a fledgling, says time on the ground can be normal, and recommends giving it space while keeping pets and children away. This supports a bounded observation and non-interference relation, not species, health, parent presence, nest location, abandonment, or outcome.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:place-sparse-young-bird-or-direct-danger-changes-response",
      "source_ref": "source:place-young-bird-guidance-wcv",
      "anchor": {"section": "Nestlings: Help them get back home"},
      "note": "The Wildlife Center of Virginia describes a young bird with few or no feathers as a nestling and advises returning it to its nest if possible. This does not establish a nest, safe access, handling method, injury, feeding, treatment, or survival.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:place-young-bird-direct-danger-nearby-move",
      "source_ref": "source:place-young-bird-guidance-werc",
      "anchor": {"section": "Baby Birds"},
      "note": "WERC distinguishes barely feathered nestlings from feathered fledglings, advises leaving a fledgling alone unless injured, and where cats threaten it recommends removing the cats or moving the bird only within a short radius. This supports only a nearby move under immediate danger, not distance, treatment, health, parent behaviour, or a destination invented by WK.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:place-domestic-fowl-body-wing-support",
      "source_ref": "source:place-poultry-examination-merck",
      "anchor": {"section": "Physical Examination of Backyard Poultry"},
      "note": "Merck advises holding domestic-fowl wings folded close to the body, supporting the breast while lifting, avoiding upside-down restraint, and not squeezing the breast because thoracic compression compromises breathing. This is a brief examination boundary, not a force, duration, species protocol, diagnosis, treatment, or guarantee of safety.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:place-domestic-fowl-whole-body-and-wing-restraint",
      "source_ref": "source:place-poultry-handling-penn-state",
      "anchor": {"section": "Handling demonstration"},
      "note": "Penn State Extension advises restraining the wings, lifting the whole body rather than the wings alone, supporting the bird with one arm, and covering the wings with the other to reduce flapping injury. This does not establish a medieval handling custom, exact technique, force, duration, diagnosis, or outcome.",
      "review_status": "approved"
    },
    {
      "schema": "world_knowledge_evidence_v1",
      "evidence_ref": "evidence:place-poultry-observable-emergency-signs",
      "source_ref": "source:place-poultry-examination-merck",
      "anchor": {"section": "Physical Examination of Backyard Poultry"},
      "note": "Merck identifies acute hemorrhage, open fractures, extreme respiratory difficulty, weakness, and severe neurologic or posture abnormalities as findings that require emergency care before ordinary examination. This supports stopping casual handling and seeking more experienced help, not diagnosis, cause, contagion, treatment, available specialist, or outcome.",
      "review_status": "approved"
    }
  ],
