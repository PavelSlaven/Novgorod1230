+void item_contents::add_pocket_preserving_identity( item &&pocket_item )
+{
+    units::volume total_nonrigid_volume = 0_ml;
+    units::volume effective_nonrigid_volume = 0_ml;
+    const int pocket_size = pocket_item.get_pocket_size();
+    for( item_pocket *i_pocket : pocket_item.get_container_pockets() ) {
+        const units::volume volume = i_pocket->volume_capacity();
+        const units::volume magazine_well = i_pocket->magazine_well();
+        const float encumbrance_modifier = i_pocket->get_pocket_data()->volume_encumber_modifier;
+        contents.insert( --contents.end(), std::move( *i_pocket ) );
+        ( ++contents.rbegin() )->name_as_description = true;
+        total_nonrigid_volume += volume;
+        effective_nonrigid_volume += ( volume - magazine_well ) * encumbrance_modifier;
+    }
+    additional_pockets_volume += total_nonrigid_volume;
+    additional_pockets_effective_volume += effective_nonrigid_volume;
+    additional_pockets_space_used += pocket_size;
+    additional_pockets.push_back( std::move( pocket_item ) );
+    additional_pockets.back().clear_items();
+}
